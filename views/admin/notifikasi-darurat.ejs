<!-- Notifikasi Darurat Management Page -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Notifikasi Darurat</h2>
            <p class="text-textSecondary">Kelola dan pantau notifikasi darurat untuk anak-anak</p>
        </div>
        <a href="/admin/notifikasi-darurat/add" class="bg-secondary text-textPrimary px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
            <i class="fas fa-plus mr-2"></i> Tambah Notifikasi
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-1 gap-6 mb-6">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <div class="flex items-center">
                <div class="bg-primary text-white p-3 rounded-full">
                    <i class="fas fa-exclamation-triangle text-xl"></i>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-textPrimary">Total Notifikasi</h3>
                    <p class="text-2xl font-bold text-textPrimary">
                        <%= stats.total %>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <form method="GET" class="flex flex-col md:flex-row gap-4">
            <div class="flex-1">
                <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Cari berdasarkan deskripsi atau nama anak..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="flex gap-2">
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-search mr-2"></i>
                    Cari
                </button>
                <a href="/admin/notifikasi-darurat" class="bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    <i class="fas fa-times mr-2"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Notifikasi Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Anak
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Deskripsi
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Tanggal
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Aksi
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (notifikasiList && notifikasiList.length > 0) { %>
                        <% notifikasiList.forEach(notifikasi => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center">
                                            <span class="text-white font-semibold text-sm">
                                                <%= notifikasi.anak && notifikasi.anak.nama ? notifikasi.anak.nama.charAt(0).toUpperCase() : 'N' %>
                                            </span>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-textPrimary">
                                                <%= notifikasi.anak && notifikasi.anak.nama ? notifikasi.anak.nama : 'Anak tidak ditemukan' %>
                                            </div>
                                            <div class="text-sm text-textSecondary">
                                                Orang Tua:
                                                <%= notifikasi.anak && notifikasi.anak.orangTua && notifikasi.anak.orangTua.nama ? notifikasi.anak.orangTua.nama : 'Tidak tersedia' %>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-textPrimary">
                                        <%= notifikasi.deskripsi.length > 100 ? notifikasi.deskripsi.substring(0, 100) + '...' : notifikasi.deskripsi %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-textSecondary">
                                    <%= new Date(notifikasi.createdAt).toLocaleDateString('id-ID', { 
                                        year: 'numeric', 
                                        month: 'long', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <div class="flex space-x-2">
                                        <a href="/admin/notifikasi-darurat/detail/<%= notifikasi.id %>" class="text-primary hover:text-primary-dark" title="Detail">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="/admin/notifikasi-darurat/edit/<%= notifikasi.id %>" class="text-warning hover:text-warning-dark" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/admin/notifikasi-darurat/delete/<%= notifikasi.id %>" class="text-danger hover:text-danger-dark" title="Hapus" onclick="return confirm('Apakah Anda yakin ingin menghapus notifikasi ini?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="px-6 py-12 text-center">
                                            <div class="flex flex-col items-center">
                                                <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center mb-4">
                                                    <i class="fas fa-exclamation-triangle text-2xl text-gray-400"></i>
                                                </div>
                                                <h3 class="text-lg font-medium text-textPrimary mb-2">Tidak ada notifikasi darurat</h3>
                                                <p class="text-textSecondary mb-4">Belum ada notifikasi darurat yang terdaftar dalam sistem.</p>
                                                <a href="/admin/notifikasi-darurat/add" class="bg-secondary text-textPrimary px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                                    <i class="fas fa-plus mr-2"></i> Tambah Notifikasi Darurat
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                <div class="flex-1 flex justify-between sm:hidden">
                    <% if (pagination.hasPrev) { %>
                        <a href="?page=<%= pagination.currentPage - 1 %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-textPrimary bg-white hover:bg-gray-50">
                            Previous
                        </a>
                        <% } %>
                            <% if (pagination.hasNext) { %>
                                <a href="?page=<%= pagination.currentPage + 1 %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-textPrimary bg-white hover:bg-gray-50">
                            Next
                        </a>
                                <% } %>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-textSecondary">
                            Halaman <span class="font-medium"><%= pagination.currentPage %></span> dari
                            <span class="font-medium"><%= pagination.totalPages %></span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <% if (pagination.hasPrev) { %>
                                <a href="?page=<%= pagination.currentPage - 1 %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                                <% } %>

                                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                        <% if (i === pagination.currentPage) { %>
                                            <span class="relative inline-flex items-center px-4 py-2 border border-primary bg-primary text-sm font-medium text-white">
                                        <%= i %>
                                    </span>
                                            <% } else { %>
                                                <a href="?page=<%= i %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                                    <%= i %>
                                                </a>
                                                <% } %>
                                                    <% } %>

                                                        <% if (pagination.hasNext) { %>
                                                            <a href="?page=<%= pagination.currentPage + 1 %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                                                <i class="fas fa-chevron-right"></i>
                                                            </a>
                                                            <% } %>
                        </nav>
                    </div>
                </div>
            </div>
            <% } %>
    </div>
</div>