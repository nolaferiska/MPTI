                                <%- body %>
                            </main>
        </div>
    </div>


    <script src="/js/admin.js"></script>

    <!-- Navigation Active State Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get current page path
            const currentPath = window.location.pathname;

            // Remove active class from all nav items
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });

            // Add active class to current page
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => {
                const href = item.getAttribute('href');
                if (currentPath === href || (currentPath.startsWith(href) && href !== '/admin/dashboard')) {
                    item.classList.add('active');
                }
            });

            // Special case for dashboard
            if (currentPath === '/admin/dashboard' || currentPath === '/admin') {
                document.querySelector('[data-page="dashboard"]').classList.add('active');
            }
        });
    </script>



<script src="/socket.io/socket.io.js"></script>
<script>
    window.currentUserId = <%= currentUserId %>;
    const socket = io();
    
    let onlineUsers = new Set();
    let activeUserId = null;
    let currentMessages = []; // Initialize current messages
    
    const STORAGE_KEY = 'admin_active_chat';

    // DOM refs
    const userItems = document.querySelectorAll('.user-item');
    const chatHeader = document.getElementById('chatHeader');
    const selectedUserInitial = document.getElementById('selectedUserInitial');
    const selectedUserName = document.getElementById('selectedUserName');
    const welcomeMessage = document.getElementById('welcomeMessage');
    const messagesArea = document.getElementById('messagesArea');
    const messagesContainer = document.getElementById('messagesContainer');
    const messageInput = document.getElementById('messageInput');
    const messageForm = document.getElementById('messageForm');
    const messageText = document.getElementById('messageText');

    // Initialize socket connection
    socket.on('connect', () => {
        console.log('ADMIN SOCKET connected:', socket.id);
        // Join user's room
        socket.emit('join_room', { userId: window.currentUserId });
    });

    // Chat state management
    function saveChatState(userId, userName) {
        const chatState = {
            userId: userId,
            userName: userName,
            timestamp: Date.now()
        };
        try {
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(chatState));
        } catch (e) {
            console.warn('Could not save chat state:', e);
        }
    }

    function loadChatState() {
        try {
            const savedState = sessionStorage.getItem(STORAGE_KEY);
            if (savedState) {
                const chatState = JSON.parse(savedState);
                // Check if state is not too old (1 hour)
                if (Date.now() - chatState.timestamp < 3600000) {
                    return chatState;
                }
            }
        } catch (e) {
            console.warn('Could not load chat state:', e);
        }
        return null;
    }

    function clearChatState() {
        try {
            sessionStorage.removeItem(STORAGE_KEY);
        } catch (e) {
            console.warn('Could not clear chat state:', e);
        }
    }

    function selectUser(userId, userName) {
        if (activeUserId === userId) return;

        activeUserId = userId;
        saveChatState(userId, userName);

        // Update UI
        userItems.forEach(item => {
            if (item.getAttribute('data-user-id') === userId) {
                item.classList.add('bg-gray-100');
            } else {
                item.classList.remove('bg-gray-100');
            }
        });

        // Show chat interface
        chatHeader.classList.remove('hidden');
        selectedUserInitial.textContent = userName.charAt(0).toUpperCase();
        selectedUserName.textContent = userName;
        welcomeMessage.classList.add('hidden');
        messagesArea.classList.remove('hidden');
        messageInput.classList.remove('hidden');

        // Load messages
        loadMessages(userId);
    }

    function loadMessages(userId) {
        messagesContainer.innerHTML = '<div class="text-center text-gray-400 text-sm py-2">Memuat pesan...</div>';

        fetch(`/admin/komunikasi/messages/${userId}`)
            .then(res => res.json())
            .then(data => {
                currentMessages = data.messages || data || [];
                renderMessages(currentMessages);
            })
            .catch(error => {
                console.error('Error loading messages:', error);
                messagesContainer.innerHTML = '<div class="text-center text-red-400 text-sm py-2">Gagal memuat pesan</div>';
            });
    }

    function renderMessages(messages) {
        messagesContainer.innerHTML = '';

        if (!messages || messages.length === 0) {
            messagesContainer.innerHTML = '<div class="text-center text-gray-400 text-sm py-2">Belum ada pesan</div>';
            return;
        }

        messages.forEach(msg => {
            const isMe = msg.pengirim && msg.pengirim.role === 'admin';
            const div = document.createElement('div');
            div.className = `flex ${isMe ? 'justify-end' : 'justify-start'} mb-2`;

            const messageTime = new Date(msg.createdAt).toLocaleTimeString('id-ID', {
                hour: '2-digit',
                minute: '2-digit'
            });

            div.innerHTML = `
                <div class="max-w-xs">
                    <div class="px-4 py-2 rounded-2xl ${isMe ? 'bg-primary text-white' : 'bg-secondary text-textPrimary'}">
                        ${msg.pesan}
                    </div>
                    <div class="text-xs text-gray-400 mt-1 ${isMe ? 'text-right' : 'text-left'}">
                        ${messageTime}
                    </div>
                </div>
            `;
            messagesContainer.appendChild(div);
        });

        // Scroll to bottom
        setTimeout(() => {
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }, 100);
    }

    // Initialize chat on page load
    document.addEventListener('DOMContentLoaded', function() {
        const savedState = loadChatState();
        if (savedState) {
            // Find the user in the list and select them
            const userItem = document.querySelector(`[data-user-id="${savedState.userId}"]`);
            if (userItem) {
                selectUser(savedState.userId, savedState.userName);
            } else {
                // User not found, clear state
                clearChatState();
            }
        }
    });

    // User item click handlers
    userItems.forEach(item => {
        item.addEventListener('click', function() {
            const userId = this.getAttribute('data-user-id');
            const userName = this.getAttribute('data-user-name');
            selectUser(userId, userName);
        });
    });

    // Send message
    if (messageForm) {
        messageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const text = messageText.value.trim();
            if (!text || !activeUserId) return;

            // Disable form temporarily
            messageText.disabled = true;
            const submitBtn = messageForm.querySelector('button[type="submit"]');
            submitBtn.disabled = true;

            // Send via AJAX first
            fetch('/admin/komunikasi/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    penerimaId: activeUserId,
                    pesan: text
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    messageText.value = '';
                    
                    // Emit via socket for real-time updates
                    socket.emit('send_message', {
                        pengirimId: window.currentUserId,
                        penerimaId: activeUserId,
                        pesan: text,
                        senderRole: 'admin'
                    });
                    
                    console.log('Admin message sent via socket:', {
                        pengirimId: window.currentUserId,
                        penerimaId: activeUserId,
                        pesan: text
                    });
                } else {
                    console.error('Send message failed:', data.error);
                }
            })
            .catch(error => {
                console.error('Error sending message:', error);
            })
            .finally(() => {
                // Re-enable form
                messageText.disabled = false;
                submitBtn.disabled = false;
                messageText.focus();
            });
        });
    }

    // Listen for new messages (real-time)
    socket.on('new_message', function(data) {
        console.log('SOCKET NEW MESSAGE (admin):', data, 'activeUserId:', activeUserId);
        if (activeUserId && (data.pengirimId == activeUserId || data.penerimaId == activeUserId)) {
            // Add to current messages if not already there
            const existingMsg = currentMessages.find(m => m.id === data.id && m.createdAt === data.createdAt);
            if (!existingMsg) {
                currentMessages.push(data);
                renderMessages(currentMessages);
            }
        }
    });

    // Clean up on page unload
    window.addEventListener('beforeunload', function() {
        if (activeUserId) {
            // Keep the chat state for next visit
            const userItem = document.querySelector(`[data-user-id="${activeUserId}"]`);
            if (userItem) {
                const userName = userItem.getAttribute('data-user-name');
                saveChatState(activeUserId, userName);
            }
        }
    });

    function updateOnlineIndicators() {
        userItems.forEach(item => {
            const userId = item.dataset.userId; // Fixed: use correct attribute
            if (onlineUsers.has(userId)) {
                item.classList.add('online-indicator');
            } else {
                item.classList.remove('online-indicator');
            }
        });
    }

    // Listen online/offline events
    socket.on('user_online', ({ userId }) => {
        onlineUsers.add(String(userId));
        updateOnlineIndicators();
    });

    socket.on('user_offline', ({ userId }) => {
        onlineUsers.delete(String(userId));
        updateOnlineIndicators();
    });

    socket.on('online_users', (users) => {
        onlineUsers = new Set(users.map(String));
        updateOnlineIndicators();
    });

    // Request online users on load
    socket.emit('get_online_users');
</script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
                    // View toggle functionality
                    const viewToggles = document.querySelectorAll('.view-toggle');
                    const monthlyView = document.getElementById('monthlyView');
                    const childView = document.getElementById('childView');
                    const monthFilter = document.getElementById('monthFilter');

                    // Initialize
                    updateCurrentMonth();
                    loadData();

                    // View toggle event listeners
                    document.getElementById('viewByMonth').addEventListener('click', () => switchView('month'));
                    document.getElementById('viewByChild').addEventListener('click', () => switchView('child'));

                    // Filter event listeners
                    document.getElementById('statusFilter').addEventListener('change', loadData);
                    document.getElementById('selectedMonth').addEventListener('change', loadData);
                    document.getElementById('sortOrder').addEventListener('change', loadData);
                    document.getElementById('resetFilters').addEventListener('click', resetFilters);

                    // Modal event listeners
                    document.getElementById('closeModal').addEventListener('click', closeModal);
                    document.getElementById('tagihanModal').addEventListener('click', (e) => {
                        if (e.target.id === 'tagihanModal') closeModal();
                    });

                    function switchView(viewType) {
                        // Update toggle buttons
                        viewToggles.forEach(toggle => toggle.classList.remove('active'));

                        if (viewType === 'month') {
                            document.getElementById('viewByMonth').classList.add('active');
                            monthlyView.classList.remove('hidden');
                            childView.classList.add('hidden');
                            monthFilter.classList.remove('hidden');
                        } else {
                            document.getElementById('viewByChild').classList.add('active');
                            monthlyView.classList.add('hidden');
                            childView.classList.remove('hidden');
                            monthFilter.classList.add('hidden');
                        }

                        loadData();
                    }

                    function updateCurrentMonth() {
                        const selectedMonth = document.getElementById('selectedMonth').value;
                        const date = new Date(selectedMonth + '-01');
                        const monthName = date.toLocaleDateString('id-ID', {
                            month: 'long',
                            year: 'numeric'
                        });
                        document.getElementById('currentMonth').textContent = monthName;
                    }

                    async function loadData() {
                        const activeView = document.querySelector('.view-toggle.active').id;
                        const isMonthly = activeView === 'viewByMonth';

                        showLoading();

                        try {
                            const params = new URLSearchParams({
                                view: isMonthly ? 'monthly' : 'child',
                                status: document.getElementById('statusFilter').value,
                                sort: document.getElementById('sortOrder').value
                            });

                            if (isMonthly) {
                                params.append('month', document.getElementById('selectedMonth').value);
                                updateCurrentMonth();
                            }

                            const response = await fetch(`/admin/tagihan/data?${params}`);
                            const data = await response.json();

                            if (data.success) {
                                updateSummary(data.summary);

                                if (isMonthly) {
                                    renderMonthlyView(data.tagihan);
                                } else {
                                    renderChildView(data.tagihan);
                                }

                                hideLoading();
                            } else {
                                showNoData();
                            }
                        } catch (error) {
                            console.error('Error loading data:', error);
                            showNoData();
                        }
                    }

                    function showLoading() {
                        document.getElementById('contentArea').classList.add('hidden');
                        document.getElementById('noDataState').classList.add('hidden');
                        document.getElementById('loadingState').classList.remove('hidden');
                    }

                    function hideLoading() {
                        document.getElementById('loadingState').classList.add('hidden');
                        document.getElementById('contentArea').classList.remove('hidden');
                    }

                    function showNoData() {
                        document.getElementById('loadingState').classList.add('hidden');
                        document.getElementById('contentArea').classList.add('hidden');
                        document.getElementById('noDataState').classList.remove('hidden');
                    }

                    function updateSummary(summary) {
                        document.getElementById('totalTagihan').textContent = formatCurrency(summary.totalTagihan);
                        document.getElementById('totalLunas').textContent = formatCurrency(summary.totalLunas);
                        document.getElementById('totalBelumBayar').textContent = formatCurrency(summary.totalBelumBayar);
                        document.getElementById('totalAnak').textContent = summary.totalAnak;
                    }

                    function renderMonthlyView(tagihan) {
                        const container = document.getElementById('monthlyContent');

                        if (!tagihan || tagihan.length === 0) {
                            container.innerHTML = '<p class="text-gray-500 text-center py-8">Tidak ada tagihan untuk bulan ini</p>';
                            return;
                        }

                        container.innerHTML = tagihan.map(item => `
            <div class="tagihan-card border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-all cursor-pointer" onclick="viewTagihanDetail('${item.anakId}', '${item.periode}')">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-bold text-lg mr-3">
                            ${item.namaAnak.charAt(0).toUpperCase()}
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800">${item.namaAnak}</h3>
                            <p class="text-sm text-gray-600">ID: ${item.anakId}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-lg font-bold text-gray-800">${formatCurrency(item.jumlah)}</p>
                        <span class="status-badge status-${item.status}">${getStatusText(item.status)}</span>
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-gray-500">Jatuh Tempo:</span>
                        <p class="font-medium">${formatDate(item.tanggalJatuhTempo)}</p>
                    </div>
                    <div>
                        <span class="text-gray-500">Pembayaran:</span>
                        <p class="font-medium">${item.totalPembayaran} transaksi</p>
                    </div>
                </div>
            </div>
        `).join('');
                    }

                    function renderChildView(children) {
                        const container = document.getElementById('childContent');

                        if (!children || children.length === 0) {
                            container.innerHTML = '<p class="text-gray-500 text-center py-8">Tidak ada data anak</p>';
                            return;
                        }

                        container.innerHTML = children.map(child => `
            <div class="tagihan-card border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-all cursor-pointer" onclick="viewChildTagihan('${child.id}')">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center">
                        <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full flex items-center justify-center text-white font-bold text-lg mr-3">
                            ${child.nama.charAt(0).toUpperCase()}
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800">${child.nama}</h3>
                            <p class="text-sm text-gray-600">Orang Tua: ${child.orangTuaNama}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-lg font-bold text-gray-800">${formatCurrency(child.totalTagihan)}</p>
                        <p class="text-sm text-gray-600">${child.totalPeriode} periode</p>
                    </div>
                </div>
                
                <div class="grid grid-cols-3 gap-2 text-xs">
                    <div class="text-center p-2 bg-red-50 rounded">
                        <div class="text-red-600 font-bold">${child.belumBayar}</div>
                        <div class="text-red-500">Belum Bayar</div>
                    </div>
                    <div class="text-center p-2 bg-yellow-50 rounded">
                        <div class="text-yellow-600 font-bold">${child.sebagian || 0}</div>
                        <div class="text-yellow-500">Sebagian</div>
                    </div>
                    <div class="text-center p-2 bg-green-50 rounded">
                        <div class="text-green-600 font-bold">${child.lunas}</div>
                        <div class="text-green-500">Lunas</div>
                    </div>
                </div>
            </div>
        `).join('');
                    }

                    function resetFilters() {
                        document.getElementById('statusFilter').value = 'all';
                        document.getElementById('selectedMonth').value = new Date().toISOString().slice(0, 7);
                        document.getElementById('sortOrder').value = 'newest';
                        loadData();
                    }

                    function formatCurrency(amount) {
                        return new Intl.NumberFormat('id-ID', {
                            style: 'currency',
                            currency: 'IDR',
                            minimumFractionDigits: 0
                        }).format(amount);
                    }

                    function formatDate(dateString) {
                        if (!dateString) return '-';
                        return new Date(dateString).toLocaleDateString('id-ID');
                    }

                    function getStatusText(status) {
                        const statusMap = {
                            'lunas': 'Lunas',
                            'belum_bayar': 'Belum Bayar',
                            'sebagian': 'Sebagian'
                        };
                        return statusMap[status] || status;
                    }

                    async function viewTagihanDetail(anakId, periode) {
                        try {
                            const response = await fetch(`/admin/tagihan/detail/${anakId}/${periode}`);
                            const data = await response.json();

                            if (data.success) {
                                document.getElementById('modalTitle').textContent = `Detail Tagihan ${data.anak.nama} - ${data.periodeName}`;
                                document.getElementById('modalContent').innerHTML = renderTagihanDetail(data);
                                document.getElementById('tagihanModal').classList.remove('hidden');
                            }
                        } catch (error) {
                            console.error('Error loading tagihan detail:', error);
                        }
                    }

                    async function viewChildTagihan(anakId) {
                        try {
                            const response = await fetch(`/admin/tagihan/child/${anakId}`);
                            const data = await response.json();

                            if (data.success) {
                                document.getElementById('modalTitle').textContent = `Tagihan ${data.anak.nama}`;
                                document.getElementById('modalContent').innerHTML = renderChildTagihanDetail(data);
                                document.getElementById('tagihanModal').classList.remove('hidden');
                            }
                        } catch (error) {
                            console.error('Error loading child tagihan:', error);
                        }
                    }

                    function renderTagihanDetail(data) {
                        return `
            <div class="space-y-6">
                <!-- Anak Info -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-800 mb-2">Informasi Anak</h4>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div><span class="text-gray-500">Nama:</span> <span class="font-medium">${data.anak.nama}</span></div>
                        <div><span class="text-gray-500">Orang Tua:</span> <span class="font-medium">${data.orangTua.nama}</span></div>
                        <div><span class="text-gray-500">Periode:</span> <span class="font-medium">${data.periodeName}</span></div>
                        <div><span class="text-gray-500">Status:</span> <span class="status-badge status-${data.tagihan.status}">${getStatusText(data.tagihan.status)}</span></div>
                    </div>
                </div>
                
                <!-- Tagihan Info -->
                <div class="bg-blue-50 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-800 mb-2">Detail Tagihan</h4>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div><span class="text-gray-500">Total Tagihan:</span> <span class="font-bold text-lg">${formatCurrency(data.tagihan.jumlah)}</span></div>
                        <div><span class="text-gray-500">Jatuh Tempo:</span> <span class="font-medium">${formatDate(data.tagihan.tanggalJatuhTempo)}</span></div>
                        <div><span class="text-gray-500">Total Dibayar:</span> <span class="font-medium text-green-600">${formatCurrency(data.totalPaid)}</span></div>
                        <div><span class="text-gray-500">Sisa Tagihan:</span> <span class="font-medium text-red-600">${formatCurrency(data.remainingAmount)}</span></div>
                    </div>
                </div>
                
                <!-- Payment History -->
                ${data.payments.length > 0 ? `
                    <div>
                        <h4 class="font-semibold text-gray-800 mb-3">Riwayat Pembayaran</h4>
                        <div class="space-y-2">
                            ${data.payments.map(payment => `
                                <div class="border border-gray-200 rounded-lg p-3">
                                    <div class="flex justify-between items-center">
                                        <div>
                                            <p class="font-medium">Order ID: ${payment.orderId}</p>
                                            <p class="text-sm text-gray-600">${formatDate(payment.createdAt)} - ${payment.paymentType || 'N/A'}</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="font-bold">${formatCurrency(payment.jumlahBayar)}</p>
                                            <span class="status-badge status-${payment.transactionStatus === 'settlement' || payment.transactionStatus === 'capture' ? 'lunas' : 'belum-bayar'}">
                                                ${payment.transactionStatus === 'settlement' || payment.transactionStatus === 'capture' ? 'Berhasil' : payment.transactionStatus === 'pending' ? 'Pending' : 'Gagal'}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                ` : '<p class="text-gray-500 text-center py-4">Belum ada riwayat pembayaran</p>'}
            </div>
        `;
    }
    
    function renderChildTagihanDetail(data) {
        return `
            <div class="space-y-6">
                <!-- Anak Info -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-800 mb-2">Informasi Anak</h4>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div><span class="text-gray-500">Nama:</span> <span class="font-medium">${data.anak.nama}</span></div>
                        <div><span class="text-gray-500">Orang Tua:</span> <span class="font-medium">${data.orangTua.nama}</span></div>
                        <div><span class="text-gray-500">Tanggal Masuk:</span> <span class="font-medium">${formatDate(data.anak.tanggalMasuk)}</span></div>
                        <div><span class="text-gray-500">Total Tagihan:</span> <span class="font-bold text-lg">${formatCurrency(data.totalTagihan)}</span></div>
                    </div>
                </div>
                
                <!-- Tagihan List -->
                <div>
                    <h4 class="font-semibold text-gray-800 mb-3">Daftar Tagihan Per Periode</h4>
                    <div class="space-y-3">
                        ${data.periods.map(period => `
                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="flex justify-between items-center">
                                    <div>
                                        <h5 class="font-medium">${period.periodeName}</h5>
                                        <p class="text-sm text-gray-600">Periode: ${period.periode}</p>
                                        ${period.tagihan && period.tagihan.tanggalJatuhTempo ? `<p class="text-sm text-gray-600">Jatuh Tempo: ${formatDate(period.tagihan.tanggalJatuhTempo)}</p>` : ''}
                                    </div>
                                    <div class="text-right">
                                        <p class="font-bold text-lg">${formatCurrency(period.jumlah)}</p>
                                        <span class="status-badge status-${period.status}">${getStatusText(period.status)}</span>
                                    </div>
                                </div>
                                
                                ${period.tagihan && period.tagihan.pembayaran && period.tagihan.pembayaran.length > 0 ? `
                                    <div class="mt-3 pt-3 border-t border-gray-100">
                                        <p class="text-sm text-gray-600 mb-2">Riwayat Pembayaran:</p>
                                        ${period.tagihan.pembayaran.map(payment => `
                                            <div class="flex justify-between items-center text-sm">
                                                <span>${payment.orderId} - ${formatDate(payment.createdAt)}</span>
                                                <span class="font-medium">${formatCurrency(payment.jumlahBayar)}</span>
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : ''}
                            </div>
                        `).join('')}
                    </div>
                </div>
            </div>
        `;
    }
    
    function closeModal() {
        document.getElementById('tagihanModal').classList.add('hidden');
    }
});
    </script>

    
<script>
function showTab(tab) {
    // Tab button active state
    document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('border-blue-500', 'text-blue-600'));
    if (tab === 'all') {
        document.getElementById('tab-all').classList.add('border-blue-500', 'text-blue-600');
    } else if (tab === 'belumBayar') {
        document.getElementById('tab-belumBayar').classList.add('border-blue-500', 'text-blue-600');
    } else if (tab === 'lunas') {
        document.getElementById('tab-lunas').classList.add('border-blue-500', 'text-blue-600');
    }
    // Row filter
    document.querySelectorAll('.student-row').forEach(row => {
        const status = row.getAttribute('data-status');
        const hasTagihan = row.getAttribute('data-has-tagihan');
        if (tab === 'all') {
            row.style.display = '';
        } else if (tab === 'belumBayar') {
            // Belum bayar = status !== 'lunas'
            if (status !== 'lunas') {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        } else if (tab === 'lunas') {
            if (status === 'lunas') {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        }
    });
}
// Set default tab
showTab('all');
</script>
</body>

</html>