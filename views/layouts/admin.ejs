<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Tailwind CSS - Compiled -->
    <link href="/css/output.css" rel="stylesheet">

    <!-- Google Fonts - Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        .online-indicator {
            background: #e0ffe0 !important;
            position: relative;
        }
        
        .online-indicator::before {
            content: '';
            display: inline-block;
            width: 10px;
            height: 10px;
            background: #2ecc40;
            border-radius: 50%;
            margin-right: 6px;
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
        }
    </style>
    <style>
        .tab-button {
            transition: all 0.2s ease-in-out;
        }
        
        .tab-button:hover {
            cursor: pointer;
        }
        /* Active navigation item styling */
        
        .nav-item.active {
            background-color: #f4e55e;
            /* tertiary color */
            color: #2C3E50;
            /* textPrimary for better contrast */
        }
        
        .nav-item.active i,
        .nav-item.active span {
            color: #2C3E50;
            /* textPrimary for better contrast */
        }
    </style>
    <style>
        #messagesContainer {
            scroll-behavior: auto !important;
            /* Instant scroll, no smooth transition */
            display: flex;
            flex-direction: column;
            height: 100%;
            /* Ensure full height */
        }
        /* Ensure messages container maintains scroll position */
        
        .messages-area {
            position: relative;
            overflow-y: auto !important;
            height: 100%;
        }
        /* Help with scroll positioning */
        
        .chat-message {
            scroll-margin-bottom: 0.5rem;
            margin-bottom: 1rem;
            /* Add spacing between messages */
        }
        /* Force scroll to show latest messages */
        
        .messages-area.force-bottom::after {
            content: '';
            height: 1px;
            width: 1px;
        }
    </style>

    <style>
        .view-toggle.active {
            background-color: #3B82F6;
            color: white;
        }
        
        .view-toggle:not(.active) {
            color: #6B7280;
        }
        
        .view-toggle:not(.active):hover {
            background-color: #E5E7EB;
        }
        
        .tagihan-card {
            transition: all 0.2s ease;
        }
        
        .tagihan-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .status-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .status-lunas {
            background-color: #DEF7EC;
            color: #03543F;
        }
        
        .status-belum-bayar {
            background-color: #FEE2E2;
            color: #991B1B;
        }
        
        .status-sebagian {
            background-color: #FEF3C7;
            color: #92400E;
        }
    </style>

</head>

<body class="font-poppins bg-primary">
