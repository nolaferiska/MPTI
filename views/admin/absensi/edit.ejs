<!-- Edit Absensi Form -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Edit Absensi</h2>
            <p class="text-textSecondary">Edit absensi untuk semua anak pada tanggal tertentu</p>
        </div>
        <a href="/admin/absensi" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Kembali
        </a>
    </div>

    <!-- Form -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <form method="POST" action="/admin/absensi/edit" class="space-y-6">
            <!-- Date Selection -->
            <div class="mb-6">
                <label for="tanggal" class="block text-sm font-medium text-textPrimary mb-2">
                    Tanggal Absensi <span class="text-danger">*</span>
                </label>
                <input type="date" id="tanggal" name="tanggal" value="<%= selectedDate.toISOString().split('T')[0] %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>

            <!-- Children List -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-textPrimary">Daftar Anak</h3>

                <% if (children && children.length > 0) { %>
                    <div class="grid grid-cols-1 gap-4">
                        <% children.forEach(child => { %>
                            <% const existingAtt = existingAttendance[child.id]; %>
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center space-x-4">
                                            <div class="flex-shrink-0 h-12 w-12">
                                                <% if (child.foto) { %>
                                                    <img class="h-12 w-12 rounded-full object-cover" src="<%= child.foto %>" alt="<%= child.nama %>">
                                                    <% } else { %>
                                                        <div class="h-12 w-12 rounded-full bg-primary text-white flex items-center justify-center">
                                                            <i class="fas fa-child"></i>
                                                        </div>
                                                        <% } %>
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-medium text-textPrimary">
                                                    <%= child.nama %>
                                                </h4>
                                                <p class="text-sm text-textSecondary">
                                                    <%= child.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %> •
                                                        <%= child.age %> tahun
                                                </p>
                                                <% if (child.orangTua) { %>
                                                    <p class="text-xs text-textSecondary">Orang Tua:
                                                        <%= child.orangTua.nama %>
                                                    </p>
                                                    <% } %>
                                            </div>
                                        </div>

                                        <div class="flex items-center space-x-2">
                                            <label class="flex items-center">
                                                <input type="radio" name="absensiData[<%= child.id %>][status]" value="hadir" 
                                                    <%= existingAtt && existingAtt.status === 'hadir' ? 'checked' : '' %>
                                                    class="rounded border-gray-300 text-primary focus:ring-primary"
                                                    required>
                                                <span class="ml-2 text-sm text-textPrimary">Hadir</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="radio" name="absensiData[<%= child.id %>][status]" value="alpha" 
                                                    <%= existingAtt && existingAtt.status === 'alpha' ? 'checked' : '' %>
                                                    class="rounded border-gray-300 text-primary focus:ring-primary"
                                                    required>
                                                <span class="ml-2 text-sm text-textPrimary">Alpha</span>
                                            </label>
                                            <!-- Hidden input to ensure child ID is always sent -->
                                            <input type="hidden" name="absensiData[<%= child.id %>][anakId]" value="<%= child.id %>">
                                        </div>
                                    </div>


                                </div>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <div class="text-center py-8">
                            <i class="fas fa-child text-4xl text-gray-300 mb-4"></i>
                            <p class="text-lg font-medium text-textSecondary">Tidak ada data anak</p>
                            <p class="text-sm text-textSecondary">Belum ada data anak yang ditambahkan</p>
                        </div>
                        <% } %>
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a href="/admin/absensi" class="bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    Batal
                </a>
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-save mr-2"></i>
                    Update Absensi
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Auto-fill current time for check-in/check-out if empty
    document.addEventListener('DOMContentLoaded', function() {
        const now = new Date();
        const currentTime = now.toTimeString().slice(0, 5);

        // Set default time for empty time inputs
        const timeInputs = document.querySelectorAll('input[type="time"]');
        timeInputs.forEach(input => {
            if (!input.value) {
                input.value = currentTime;
            }
        });
    });
</script>