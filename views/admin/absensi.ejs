<!-- Absensi Management Page -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Rekap Absensi Anak</h2>
            <p class="text-textSecondary">Manajemen dan rekap absensi harian anak di daycare</p>
        </div>
        <a href="/admin/absensi/add" class="bg-secondary text-textPrimary px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
            <i class="fas fa-plus mr-2"></i> Tambah Absensi
        </a>
    </div>

    <!-- Attendance Summary Table -->
    <div class="bg-secondary rounded-lg shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-textPrimary">Rekap Absensi Harian</h3>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-quaternary">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Tanggal</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Jumlah Hadir</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Jumlah Tidak Hadir</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Total Anak</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-secondary divide-y divide-gray-200">
                    <% if (attendanceSummary && attendanceSummary.length > 0) { %>
                        <% attendanceSummary.forEach(summary => { %>
                            <tr class="hover:bg-secondary">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-textPrimary">
                                        <%= new Date(summary.date).toLocaleDateString('id-ID', { 
                                            weekday: 'long', 
                                            year: 'numeric', 
                                            month: 'long', 
                                            day: 'numeric' 
                                        }) %>
                                    </div>
                                    <div class="text-sm text-textSecondary">
                                        <%= new Date(summary.date).toLocaleDateString('id-ID') %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-success rounded-full mr-2"></div>
                                        <span class="text-sm font-medium text-textPrimary">
                                            <%= summary.hadir %>
                                        </span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-danger rounded-full mr-2"></div>
                                        <span class="text-sm font-medium text-textPrimary">
                                            <%= summary.alpha %>
                                        </span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-textPrimary">
                                        <%= summary.total %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <div class="flex space-x-2">
                                        <a href="/admin/absensi/detail?date=<%= summary.date.toISOString().split('T')[0] %>" class="text-primary hover:text-primary-dark transition-colors">
                                            <i class="fas fa-eye mr-1"></i> Detail
                                        </a>
                                        <a href="/admin/absensi/edit?date=<%= summary.date.toISOString().split('T')[0] %>" class="text-warning hover:text-warning-dark transition-colors">
                                            <i class="fas fa-edit mr-1"></i> Edit
                                        </a>
                                        <a href="/admin/absensi/delete/<%= summary.date.toISOString().split('T')[0] %>" class="text-danger hover:text-danger-dark transition-colors" onclick="return confirm('Apakah Anda yakin ingin menghapus semua data absensi untuk tanggal ini?')">
                                            <i class="fas fa-trash mr-1"></i> Hapus
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="px-6 py-4 text-center text-textSecondary">
                                            <div class="flex flex-col items-center py-8">
                                                <i class="fas fa-calendar-alt text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">Belum ada data absensi</p>
                                                <p class="text-sm">Mulai dengan menambahkan absensi untuk hari ini</p>
                                                <a href="/admin/absensi/add" class="mt-4 bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                                    <i class="fas fa-plus mr-2"></i> Tambah Absensi
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>