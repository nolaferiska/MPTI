// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int        @id @default(autoincrement())
  username                String?    @unique @db.VarChar(50)
  email                   String     @unique @db.VarChar(100)
  password                String     @db.VarChar(255)
  role                    UserRole
  nama                    String     @db.VarChar(100)
  telepon                 String?    @db.VarChar(20)
  alamat                  String?    @db.Text
  foto                    String?    @db.VarChar(255)
  status                  UserStatus @default(aktif)
  emailVerified           Boolean    @default(false) @map("email_verified")
  emailVerificationToken  String?    @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime? @map("email_verification_expires")
  passwordResetToken      String?    @db.VarChar(255)
  passwordResetExpires    DateTime?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  // Relations
  anakAsOrangTua           Anak[]
  absensiCreated           Absensi[]
  komunikasiAsPengirim     Komunikasi[]        @relation("PengirimKomunikasi")
  komunikasiAsPenerima     Komunikasi[]        @relation("PenerimaKomunikasi")
  tagihan                  Tagihan[]
  notifikasiDaruratCreated NotifikasiDarurat[]

  @@map("users")
}

model Pengasuh {
  id               Int            @id @default(autoincrement())
  nama             String         @db.VarChar(100)
  email            String?        @unique @db.VarChar(100)
  telepon          String?        @db.VarChar(20)
  alamat           String?        @db.Text
  tanggalLahir     DateTime?      @map("tanggal_lahir") @db.Date
  jenisKelamin     JenisKelamin?  @map("jenis_kelamin")
  pendidikan       String?        @db.VarChar(100)
  pengalaman       String?        @db.Text
  foto             String?        @db.VarChar(255)
  tanggalBergabung DateTime?      @map("tanggal_bergabung") @db.Date
  status           PengasuhStatus @default(aktif)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("pengasuh")
}

model Anak {
  id               Int          @id @default(autoincrement())
  nama             String       @db.VarChar(100)
  tanggalLahir     DateTime     @map("tanggal_lahir") @db.Date
  jenisKelamin     JenisKelamin @map("jenis_kelamin")
  alamat           String?      @db.Text
  teleponDarurat   String?      @map("telepon_darurat") @db.VarChar(20)
  kondisiKesehatan String?      @map("kondisi_kesehatan") @db.Text
  alergi           String?      @db.Text
  foto             String?      @db.VarChar(255)
  dokumenAnak      String?      @db.VarChar(255) // path dokumen upload
  orangTuaId       Int?         @map("orang_tua_id")
  tanggalMasuk     DateTime?    @map("tanggal_masuk") @db.Date
  status           AnakStatus   @default(aktif)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  orangTua          User?               @relation(fields: [orangTuaId], references: [id], onDelete: Cascade)
  absensi           Absensi[]
  tagihan           Tagihan[]
  notifikasiDarurat NotifikasiDarurat[]

  @@map("anak")
}

model Absensi {
  id        Int           @id @default(autoincrement())
  anakId    Int           @map("anak_id")
  tanggal   DateTime      @db.Date
  status    AbsensiStatus
  createdBy Int?          @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  anak          Anak  @relation(fields: [anakId], references: [id], onDelete: Cascade)
  createdByUser User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([anakId, tanggal])
  @@map("absensi")
}

model Aktivitas {
  id            Int       @id @default(autoincrement())
  tanggal       DateTime  @db.Date
  namaAktivitas String    @map("nama_aktivitas") @db.VarChar(100)
  deskripsi     String    @db.Text
  waktuMulai    DateTime? @map("waktu_mulai") @db.Time
  waktuSelesai  DateTime? @map("waktu_selesai") @db.Time
  foto          String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("aktivitas")
}

model Komunikasi {
  id         Int      @id @default(autoincrement())
  pengirimId Int      @map("pengirim_id")
  penerimaId Int      @map("penerima_id")
  pesan      String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  pengirim User @relation("PengirimKomunikasi", fields: [pengirimId], references: [id], onDelete: Cascade)
  penerima User @relation("PenerimaKomunikasi", fields: [penerimaId], references: [id], onDelete: Cascade)

  @@map("komunikasi")
}

model Tagihan {
  id                Int           @id @default(autoincrement())
  orangTuaId        Int           @map("orang_tua_id")
  anakId            Int           @map("anak_id")
  periodeBulan      String        @map("periode_bulan") @db.VarChar(7)
  jumlah            Decimal       @db.Decimal(12, 2)
  tanggalJatuhTempo DateTime?     @map("tanggal_jatuh_tempo") @db.Date
  status            StatusTagihan @default(belum_bayar)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  orangTua   User         @relation(fields: [orangTuaId], references: [id], onDelete: Cascade)
  anak       Anak         @relation(fields: [anakId], references: [id], onDelete: Cascade)
  pembayaran Pembayaran[]

  @@map("tagihan")
}

model Pembayaran {
  id          Int     @id @default(autoincrement())
  tagihanId   Int     @map("tagihan_id")
  jumlahBayar Decimal @map("jumlah_bayar") @db.Decimal(12, 2)

  // Midtrans Payment Gateway Fields
  orderId           String         @unique @map("order_id") @db.VarChar(100) // Unique order ID for Midtrans
  transactionId     String?        @map("transaction_id") @db.VarChar(200) // Midtrans transaction ID
  grossAmount       Decimal        @map("gross_amount") @db.Decimal(12, 2) // Total amount including fees
  paymentType       String?        @map("payment_type") @db.VarChar(50) // e.g., 'bank_transfer', 'credit_card', 'gopay'
  transactionTime   DateTime?      @map("transaction_time") // When transaction was processed
  transactionStatus MidtransStatus @default(pending) @map("transaction_status")
  fraudStatus       String?        @map("fraud_status") @db.VarChar(20) // 'accept', 'deny', 'challenge'

  // Payment Details
  bankCode   String?   @map("bank_code") @db.VarChar(10) // For bank transfer
  vaNumber   String?   @map("va_number") @db.VarChar(50) // Virtual Account number
  paymentUrl String?   @map("payment_url") @db.Text // Payment URL from Midtrans
  expiredAt  DateTime? @map("expired_at") // Payment expiration time

  // Additional Info
  keterangan       String? @db.Text
  midtransResponse String? @map("midtrans_response") @db.Text // Store full Midtrans response

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tagihan Tagihan @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@map("pembayaran")
}

model NotifikasiDarurat {
  id        Int      @id @default(autoincrement())
  anakId    Int      @map("anak_id")
  deskripsi String   @db.Text
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  anak          Anak  @relation(fields: [anakId], references: [id], onDelete: Cascade)
  createdByUser User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("notifikasi_darurat")
}

// Enums
enum UserRole {
  admin
  orang_tua
}

enum UserStatus {
  aktif
  nonaktif
  pending
}

enum JenisKelamin {
  L
  P
}

enum PengasuhStatus {
  aktif
  nonaktif
}

enum AnakStatus {
  aktif
  nonaktif
}

enum AbsensiStatus {
  hadir
  alpha
  sakit
  izin
}

enum JenisKomunikasi {
  chat
  notifikasi
}

enum StatusKomunikasi {
  terkirim
  dibaca
  dibalas
}

enum StatusTagihan {
  belum_bayar
  lunas
  sebagian
}

enum MetodePembayaran {
  tunai
  transfer
  kartu_kredit
  e_wallet
}

enum StatusPembayaran {
  pending
  berhasil
  gagal
  dibatalkan
}

enum MidtransStatus {
  pending
  capture
  settlement
  deny
  cancel
  expire
  refund
  partial_refund
  chargeback
  partial_chargeback
  authorize
}

enum JenisDarurat {
  kesehatan
  keamanan
  kecelakaan
  lainnya
}

enum StatusNotifikasiDarurat {
  aktif
  selesai
  dibatalkan
}
