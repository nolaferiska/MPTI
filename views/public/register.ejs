<div class="min-h-screen bg-primary flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex justify-center mb-6">
                <div class="bg-white/90 backdrop-blur-sm text-primary w-20 h-20 rounded-3xl flex items-center justify-center shadow-2xl border border-white/20">
                    <i class="fas fa-user-plus text-3xl"></i>
                </div>
            </div>
            <h2 class="text-4xl font-bold text-textPrimary mb-4">
                Daftar Orang Tua
            </h2>
            <p class="text-lg text-textPrimary leading-relaxed">
                Buat akun baru untuk mengakses dashboard dan memantau perkembangan anak Anda
            </p>
        </div>

        <!-- Registration Form -->
        <div class="bg-white/90 backdrop-blur-sm rounded-3xl shadow-2xl p-8 border border-white/20">
            <form class="space-y-6" method="POST" action="/register">
                <div>
                    <label for="nama" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-user mr-2 text-primary"></i>
                        Nama Lengkap
                    </label>
                    <input id="nama" name="nama" type="text" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg" placeholder="Masukkan nama lengkap Anda">
                </div>

                <div>
                    <label for="email" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-envelope mr-2 text-primary"></i>
                        Email Address
                    </label>
                    <input id="email" name="email" type="email" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg" placeholder="Masukkan email Anda">
                </div>

                <div>
                    <label for="telepon" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-phone mr-2 text-primary"></i>
                        Nomor Telepon
                    </label>
                    <input id="telepon" name="telepon" type="tel" class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg" placeholder="Masukkan nomor telepon (opsional)">
                </div>

                <div>
                    <label for="alamat" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-map-marker-alt mr-2 text-primary"></i>
                        Alamat
                    </label>
                    <textarea id="alamat" name="alamat" rows="3" class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg resize-none" placeholder="Masukkan alamat lengkap (opsional)"></textarea>
                </div>

                <div>
                    <label for="password" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-lock mr-2 text-primary"></i>
                        Password
                    </label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg pr-12" placeholder="Masukkan password (minimal 6 karakter)">
                        <button type="button" onclick="togglePassword('password')" class="absolute inset-y-0 right-0 pr-4 flex items-center text-textSecondary hover:text-primary transition-colors">
                            <i id="password-icon" class="fas fa-eye text-lg"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="confirmPassword" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-lock mr-2 text-primary"></i>
                        Konfirmasi Password
                    </label>
                    <div class="relative">
                        <input id="confirmPassword" name="confirmPassword" type="password" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg pr-12"
                            placeholder="Masukkan ulang password">
                        <button type="button" onclick="togglePassword('confirmPassword')" class="absolute inset-y-0 right-0 pr-4 flex items-center text-textSecondary hover:text-primary transition-colors">
                            <i id="confirmPassword-icon" class="fas fa-eye text-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center">
                    <input id="agree-terms" name="agree-terms" type="checkbox" required class="h-5 w-5 text-primary focus:ring-primary border-gray-300 rounded transition-all duration-300">
                    <label for="agree-terms" class="ml-3 block text-sm text-textPrimary font-medium">
                        Saya setuju dengan <a href="#" class="text-primary hover:text-secondary transition-colors font-semibold">syarat dan ketentuan</a> yang berlaku
                    </label>
                </div>

                <div>
                    <button type="submit" class="w-full bg-white/90 backdrop-blur-sm text-textPrimary py-4 px-6 rounded-2xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 border border-white/20">
                        <i class="fas fa-user-plus mr-3"></i>
                        Daftar Sekarang
                    </button>
                </div>

                <div class="text-center pt-4">
                    <p class="text-textPrimary font-medium">
                        Sudah punya akun?
                        <a href="/login" class="text-primary hover:text-secondary transition-colors font-bold">
                            Login di sini
                        </a>
                    </p>
                </div>
            </form>
        </div>

        <!-- Additional Info -->
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl p-6 mt-8 border border-white/20">
            <div class="flex items-start space-x-4">
                <div class="bg-white text-primary w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-info-circle text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-textPrimary mb-2">Informasi Registrasi</h3>
                    <p class="text-textPrimary leading-relaxed">
                        Setelah mendaftar, akun Anda akan aktif dan dapat digunakan untuk login. Pastikan data yang diisi sudah benar dan lengkap.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>