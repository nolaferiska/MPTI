<!-- Absen Anak Page -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Absen Anak</h2>
            <p class="text-textSecondary">Lihat data kehadiran anak Anda</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <% if (monthlyStats) { %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white p-6 rounded-lg shadow-sm">
                <div class="flex items-center">
                    <div class="bg-green-100 p-3 rounded-full">
                        <i class="fas fa-check text-green-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-textSecondary">Hadir</p>
                        <p class="text-2xl font-bold text-green-600"><%= monthlyStats.hadir || 0 %></p>
                    </div>
                </div>
            </div>
            
            
            
            <div class="bg-white p-6 rounded-lg shadow-sm">
                <div class="flex items-center">
                    <div class="bg-red-100 p-3 rounded-full">
                        <i class="fas fa-times text-red-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-textSecondary">Alpha</p>
                        <p class="text-2xl font-bold text-red-600"><%= monthlyStats.alpha || 0 %></p>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Search and Filter -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <form method="GET" action="/absen" class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label class="block text-sm font-medium text-textPrimary mb-2">Pilih Anak</label>
                <select name="anakId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="all" <%= !filters.anakId || filters.anakId === 'all' ? 'selected' : '' %>>Semua Anak</option>
                    <% if (anakList && anakList.length > 0) { %>
                        <% anakList.forEach(anak => { %>
                            <option value="<%= anak.id %>" <%= filters.anakId && filters.anakId == anak.id ? 'selected' : '' %>><%= anak.nama %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-textPrimary mb-2">Status</label>
                <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="all" <%= filters.status === 'all' || !filters.status ? 'selected' : '' %>>Semua Status</option>
                    <option value="hadir" <%= filters.status === 'hadir' ? 'selected' : '' %>>Hadir</option>
                    <option value="alpha" <%= filters.status === 'alpha' ? 'selected' : '' %>>Alpha</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-textPrimary mb-2">Tanggal</label>
                <input type="date" name="tanggal" value="<%= filters.tanggal || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="flex items-end">
                <button type="submit" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-search mr-2"></i>
                    Cari
                </button>
            </div>
            <div class="flex items-end">
                <a href="/absen" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    <i class="fas fa-refresh mr-2"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Absensi List -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Tanggal</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Nama Anak</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-textPrimary uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (absensiList && absensiList.length > 0) { %>
                        <% absensiList.forEach(absensi => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-textPrimary">
                                        <%= new Date(absensi.tanggal).toLocaleDateString('id-ID', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="ml-3">
                                            <div class="text-sm font-medium text-textPrimary">
                                                <%= absensi.anak ? absensi.anak.nama : 'N/A' %>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                                        <%= absensi.status === 'hadir' ? 'bg-green-100 text-green-800' : 
                                            absensi.status === 'alpha' ? 'bg-red-100 text-red-800' :
                                            'bg-red-100 text-red-800' %>">
                                        <%= absensi.status.charAt(0).toUpperCase() + absensi.status.slice(1) %>
                                    </span>
                                </td>
                                
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="px-6 py-4 text-center text-textSecondary">
                                <div class="flex flex-col items-center py-8">
                                    <i class="fas fa-calendar-check text-4xl text-gray-300 mb-4"></i>
                                    <p class="text-lg font-medium">Tidak ada data absensi</p>
                                    <p class="text-sm">
                                        <% if (anakList && anakList.length === 0) { %>
                                            Anda belum memiliki anak yang terdaftar
                                        <% } else { %>
                                            Belum ada data absensi untuk filter yang dipilih
                                        <% } %>
                                    </p>
                                    <% if (anakList && anakList.length === 0) { %>
                                        <a href="/kelola-anak/add" class="mt-4 bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                            <i class="fas fa-plus mr-2"></i> Daftarkan Anak
                                        </a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (pagination && pagination.totalPages > 1) { %>
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                <div class="flex-1 flex justify-between sm:hidden">
                    <% if (pagination.hasPrev) { %>
                        <a href="/absen?page=<%= pagination.currentPage - 1 %>&anakId=<%= filters.anakId || '' %>&status=<%= filters.status || '' %>&tanggal=<%= filters.tanggal || '' %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Sebelumnya
                        </a>
                    <% } %>
                    <% if (pagination.hasNext) { %>
                        <a href="/absen?page=<%= pagination.currentPage + 1 %>&anakId=<%= filters.anakId || '' %>&status=<%= filters.status || '' %>&tanggal=<%= filters.tanggal || '' %>" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Selanjutnya
                        </a>
                    <% } %>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Menampilkan halaman <span class="font-medium"><%= pagination.currentPage %></span> dari <span class="font-medium"><%= pagination.totalPages %></span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                            <% if (pagination.hasPrev) { %>
                                <a href="/absen?page=<%= pagination.currentPage - 1 %>&anakId=<%= filters.anakId || '' %>&status=<%= filters.status || '' %>&tanggal=<%= filters.tanggal || '' %>" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            <% } %>

                            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                <a href="/absen?page=<%= i %>&anakId=<%= filters.anakId || '' %>&status=<%= filters.status || '' %>&tanggal=<%= filters.tanggal || '' %>" class="relative inline-flex items-center px-4 py-2 border text-sm font-medium <%= i === pagination.currentPage ? 'z-10 bg-primary border-primary text-white' : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-50' %>">
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (pagination.hasNext) { %>
                                <a href="/absen?page=<%= pagination.currentPage + 1 %>&anakId=<%= filters.anakId || '' %>&status=<%= filters.status || '' %>&tanggal=<%= filters.tanggal || '' %>" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            <% } %>
                        </nav>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Information Card -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400"></i>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800">Informasi</h3>
                <div class="mt-2 text-sm text-blue-700">
                    <ul class="list-disc list-inside space-y-1">
                        <li>Data absensi diperbarui secara otomatis oleh admin daycare</li>
                        <li>Anda dapat melihat riwayat kehadiran anak dengan menggunakan filter tanggal</li>
                        <li>Statistik bulan ini menampilkan total kehadiran untuk bulan <%= new Date().toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
