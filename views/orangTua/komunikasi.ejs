<!-- Komunikasi with Admin Page -->
<div class="space-y-6" data-user-id="<%= currentUserId %>">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Komunikasi dengan Admin</h2>
            <p class="text-textSecondary">Chat langsung dengan admin untuk mendapatkan informasi terkini</p>
        </div>
    </div>

    <!-- Chat Interface -->
    <div class="bg-white rounded-lg shadow-sm">
        <div class="flex h-[600px]">
            <!-- Admin List Sidebar -->
            <div class="w-1/3 border-r border-gray-200">
                <div class="p-6 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-textPrimary">Daftar Admin</h3>
                </div>
                <div class="overflow-y-auto h-full">
                    <% if (adminList && adminList.length > 0) { %>
                        <% adminList.forEach(admin => { %>
                            <div class="admin-item p-4 border-b border-gray-100 cursor-pointer hover:bg-gray-50 transition-colors" data-admin-id="<%= admin.id %>" data-admin-name="<%= admin.nama %>">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center relative">
                                        <span class="text-white font-semibold text-sm"><%= admin.nama.charAt(0).toUpperCase() %></span>
                                        <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-success rounded-full border-2 border-white online-indicator" data-admin-id="<%= admin.id %>"></div>
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="font-medium text-textPrimary">
                                            <%= admin.nama %>
                                        </h4>
                                        <p class="text-sm text-textSecondary">
                                            <%= admin.email %>
                                        </p>
                                        <div class="flex items-center mt-1">
                                            <div class="w-2 h-2 bg-success rounded-full mr-2"></div>
                                            <span class="text-xs text-success">Online</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="p-8 text-center text-textSecondary">
                            <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-user-shield text-2xl text-gray-400"></i>
                            </div>
                            <p>Tidak ada admin tersedia</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Chat Area -->
            <div class="flex-1 flex flex-col">
                <!-- Chat Header -->
                <div class="chat-header p-6 border-b border-gray-200 hidden" id="chatHeader">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center">
                            <span class="text-white font-semibold text-sm" id="selectedAdminInitial"></span>
                        </div>
                        <div>
                            <h4 class="font-medium text-textPrimary" id="selectedAdminName"></h4>
                            <p class="text-sm text-success flex items-center">
                                <div class="w-2 h-2 bg-success rounded-full mr-2"></div>
                                Sedang online
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Welcome Message -->
                <div class="welcome-message flex-1 flex items-center justify-center" id="welcomeMessage">
                    <div class="text-center">
                        <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-comments text-3xl text-gray-400"></i>
                        </div>
                        <h3 class="text-xl font-medium text-textPrimary mb-2">Selamat Datang di Komunikasi</h3>
                        <p class="text-textSecondary">Pilih admin dari daftar di sebelah kiri untuk memulai percakapan</p>
                        <div class="mt-4 p-4 bg-blue-50 rounded-lg">
                            <p class="text-sm text-blue-700">
                                <i class="fas fa-info-circle mr-2"></i>
                                Anda dapat bertanya tentang perkembangan anak, jadwal, atau hal lainnya kepada admin
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Messages Area -->
                <div class="messages-area flex-1 p-6 overflow-y-auto hidden bg-gray-50" id="messagesArea">
                    <div id="messagesContainer" class="space-y-4"></div>
                </div>

                <!-- Message Input -->
                <div class="message-input p-6 border-t border-gray-200 hidden" id="messageInput">
                    <form id="messageForm" class="flex space-x-3">
                        <input type="text" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" id="messageText" placeholder="Ketik pesan untuk admin..." autocomplete="off">
                        <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Messages -->
    <div class="bg-white rounded-lg shadow-sm p-6">
        <h3 class="text-lg font-medium text-textPrimary mb-4">Pesan Cepat</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <button class="quick-message p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-left" data-message="Selamat pagi, bagaimana kabar anak saya hari ini?">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-sun text-green-600"></i>
                    </div>
                    <span class="text-sm text-textPrimary">Tanya kabar anak</span>
                </div>
            </button>
            <button class="quick-message p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-left" data-message="Apakah ada jadwal khusus untuk minggu ini?">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-calendar text-blue-600"></i>
                    </div>
                    <span class="text-sm text-textPrimary">Tanya jadwal</span>
                </div>
            </button>
            <button class="quick-message p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-left" data-message="Saya ingin bertanya tentang perkembangan anak saya">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-child text-purple-600"></i>
                    </div>
                    <span class="text-sm text-textPrimary">Tanya perkembangan</span>
                </div>
            </button>

        </div>
    </div>
</div>
