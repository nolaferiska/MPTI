<!-- Pengasuh Detail Page -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Detail Pengasuh</h2>
            <p class="text-textSecondary">Informasi lengkap pengasuh:
                <%= pengasuh.nama %>
            </p>
        </div>
        <div class="flex space-x-2">
            <a href="/admin/pengasuh/edit/<%= pengasuh.id %>" class="bg-warning text-white px-4 py-2 rounded-lg hover:bg-warning-dark transition-colors">
                <i class="fas fa-edit mr-2"></i> Edit
            </a>
            <a href="/admin/pengasuh" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i> Kembali
            </a>
        </div>
    </div>

    <!-- Pengasuh Information -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Basic Information -->
            <div class="bg-secondary p-6 rounded-lg shadow-sm">
                <h3 class="text-lg font-semibold text-textPrimary mb-4">Informasi Dasar</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Nama Lengkap</label>
                        <p class="text-textPrimary font-medium">
                            <%= pengasuh.nama %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Email</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.email %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Nomor Telepon</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.telepon %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Jenis Kelamin</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Tanggal Lahir</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.tanggalLahir ? new Date(pengasuh.tanggalLahir).toLocaleDateString('id-ID') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Usia</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.age ? pengasuh.age + ' tahun' : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Status</label>
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full <%= pengasuh.status === 'aktif' ? 'bg-success text-white' : 'bg-danger text-white' %>">
                            <%= pengasuh.status === 'aktif' ? 'Aktif' : 'Nonaktif' %>
                        </span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Tanggal Bergabung</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.tanggalBergabung ? new Date(pengasuh.tanggalBergabung).toLocaleDateString('id-ID') : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Address -->
            <div class="bg-secondary p-6 rounded-lg shadow-sm">
                <h3 class="text-lg font-semibold text-textPrimary mb-4">Alamat</h3>
                <p class="text-textPrimary">
                    <%= pengasuh.alamat %>
                </p>
            </div>

            <!-- Education & Experience -->
            
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="bg-secondary p-6 rounded-lg shadow-sm">
                <h3 class="text-lg font-semibold text-textPrimary mb-4">Pendidikan & Pengalaman</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Pendidikan Terakhir</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.pendidikan || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Pengalaman Kerja</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.pengalaman || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-textSecondary">Lama Bekerja</label>
                        <p class="text-textPrimary">
                            <%= pengasuh.experienceYears %> tahun</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>