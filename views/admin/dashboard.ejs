<div class="min-h-screen ">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="bg-secondary rounded-3xl shadow-lg p-8 mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-textPrimary mb-2">
                        Selamat Datang,
                        <%= user.nama %>!
                    </h1>
                    <p class="text-textSecondary">
                        Dashboard Admin - Candice Kids Daycare
                    </p>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-secondary rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-primary text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-child text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Total Anak</h3>
                        <p class="text-2xl font-bold text-textPrimary"><%= typeof totalAnak !== 'undefined' ? totalAnak : '-' %></p>
                    </div>
                </div>
            </div>

            <div class="bg-secondary rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-success text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-users text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Total Orang Tua</h3>
                        <p class="text-2xl font-bold text-text-textPrimary"><%= typeof totalOrangTua !== 'undefined' ? totalOrangTua : '-' %></p>
                    </div>
                </div>
            </div>

            <div class="bg-secondary rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-info text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-user-tie text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Total Pengasuh</h3>
                        <p class="text-2xl font-bold text-text-textPrimary"><%= typeof totalPengasuh !== 'undefined' ? totalPengasuh : '-' %></p>
                    </div>
                </div>
            </div>

            <div class="bg-secondary rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-warning text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-calendar-check text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Kehadiran Hari Ini</h3>
                        <p class="text-2xl font-bold text-text-textPrimary"><%= typeof totalHadir !== 'undefined' ? totalHadir : '-' %></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">
            <!-- Recent Activities -->
            

            <!-- Quick Actions -->
            <div class="bg-secondary rounded-3xl shadow-lg p-8">
                <h2 class="text-2xl font-bold text-textPrimary mb-6">
                    <i class="fas fa-bolt mr-3 text-textPrimary"></i> Akses Cepat
                </h2>

                <div class="grid grid-cols-2 gap-4">
                    <a href="/admin/anak" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-child text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Kelola Data Anak</h3>
                                <p class="text-sm opacity-90">Tambah, edit, dan kelola data anak</p>
                            </div>
                        </div>
                    </a>

                    <a href="/admin/pengasuh" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-user-tie text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Kelola Data Pengasuh</h3>
                                <p class="text-sm opacity-90">Kelola data pengasuh dan staff</p>
                            </div>
                        </div>
                    </a>

                    <a href="/admin/aktivitas" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-play-circle text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Aktivitas Harian</h3>
                                <p class="text-sm opacity-90">Kelola aktivitas dan jadwal anak</p>
                            </div>
                        </div>
                    </a>

                    <a href="/admin/absensi" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-calendar-check text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Absensi Anak</h3>
                                <p class="text-sm opacity-90">Kelola kehadiran dan absensi</p>
                            </div>
                        </div>
                    </a>

                    <a href="/admin/komunikasi" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-comments text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Komunikasi</h3>
                                <p class="text-sm opacity-90">Kirim pesan ke orang tua</p>
                            </div>
                        </div>
                    </a>

                    <a href="/admin/notifikasi-darurat" class="bg-danger text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-triangle text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Notifikasi Darurat</h3>
                                <p class="text-sm opacity-90">Kelola & kirim notifikasi darurat</p>
                            </div>
                        </div>
                    </a>
                    <a href="/admin/tagihan" class="bg-primary text-white p-4 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                        <div class="flex items-center">
                            <i class="fas fa-file-invoice-dollar text-2xl mr-4"></i>
                            <div>
                                <h3 class="font-semibold text-lg">Tagihan & Pembayaran</h3>
                                <p class="text-sm opacity-90">Kelola tagihan dan pembayaran</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>