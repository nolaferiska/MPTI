    <script>
        // Mobile menu toggle
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        if (mobileMenuToggle) {
            mobileMenuToggle.addEventListener('click', () => {
                sidebar.classList.toggle('-translate-x-full');
                sidebarOverlay.classList.toggle('hidden');
            });
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', () => {
                sidebar.classList.add('-translate-x-full');
                sidebarOverlay.classList.add('hidden');
            });
        }

        // Add active state to current menu item
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const menuItems = document.querySelectorAll('.nav-link');

            menuItems.forEach(item => {
                const href = item.getAttribute('href');
                if (href === currentPath) {
                    // Add active state
                    item.classList.add('bg-primary', 'text-white', 'border-l-4', 'border-white');
                    item.classList.remove('text-textPrimary', 'hover:bg-blue-50', 'hover:border-primary');

                    // Style the icon and text for active state
                    const icon = item.querySelector('i');
                    const span = item.querySelector('span');
                    if (icon) {
                        icon.classList.remove('text-gray-500', 'group-hover:text-primary');
                        icon.classList.add('text-white');
                    }
                    if (span) {
                        span.classList.remove('group-hover:text-primary');
                        span.classList.add('text-white');
                    }
                }
            });
        });
    </script>
    <script src="/js/orangTua.js"></script>

    <!-- Chat CSS for better scroll behavior -->
    <style>
        #messagesContainer {
            scroll-behavior: auto !important;
            /* Instant scroll, no smooth transition */
            display: flex;
            flex-direction: column;
            height: 100%;
            /* Ensure full height */
        }
        /* Ensure messages container maintains scroll position */
        
        .messages-area {
            position: relative;
            overflow-y: auto !important;
            height: 100%;
        }
        /* Help with scroll positioning */
        
        .chat-message {
            scroll-margin-bottom: 0.5rem;
            margin-bottom: 1rem;
            /* Add spacing between messages */
        }
        /* Force scroll to show latest messages */
        
        .messages-area.force-bottom::after {
            content: '';
            height: 1px;
            width: 1px;
        }
    </style>


<script src="/socket.io/socket.io.js"></script>
<script>
    window.currentUserId = <%= currentUserId %>;
    const socket = io();
    
    let activeAdminId = null;
    let onlineUsers = new Set();
    let currentMessages = []; // Initialize current messages

    const STORAGE_KEY = 'orangtua_active_chat';

    // DOM refs
    const adminItems = document.querySelectorAll('.admin-item');
    const chatHeader = document.getElementById('chatHeader');
    const selectedAdminInitial = document.getElementById('selectedAdminInitial');
    const selectedAdminName = document.getElementById('selectedAdminName');
    const welcomeMessage = document.getElementById('welcomeMessage');
    const messagesArea = document.getElementById('messagesArea');
    const messagesContainer = document.getElementById('messagesContainer');
    const messageInput = document.getElementById('messageInput');
    const messageForm = document.getElementById('messageForm');
    const messageText = document.getElementById('messageText');

    // Initialize socket connection
    socket.on('connect', () => {
        console.log('ORANGTUA SOCKET connected:', socket.id);
        // Join user's room
        socket.emit('join_room', { userId: window.currentUserId });
    });

    function saveChatState(adminId, adminName) {
        const chatState = {
            adminId: adminId,
            adminName: adminName,
            timestamp: Date.now()
        };
        try {
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(chatState));
        } catch (e) {
            console.warn('Could not save chat state:', e);
        }
    }

    function loadChatState() {
        try {
            const savedState = sessionStorage.getItem(STORAGE_KEY);
            if (savedState) {
                const chatState = JSON.parse(savedState);
                if (Date.now() - chatState.timestamp < 3600000) {
                    return chatState;
                }
            }
        } catch (e) {
            console.warn('Could not load chat state:', e);
        }
        return null;
    }

    function clearChatState() {
        try {
            sessionStorage.removeItem(STORAGE_KEY);
        } catch (e) {
            console.warn('Could not clear chat state:', e);
        }
    }

    function selectAdmin(adminId, adminName) {
        if (activeAdminId === adminId) return;
        activeAdminId = adminId;
        saveChatState(adminId, adminName);
        adminItems.forEach(item => {
            if (item.getAttribute('data-admin-id') === adminId) {
                item.classList.add('bg-gray-100');
            } else {
                item.classList.remove('bg-gray-100');
            }
        });
        chatHeader.classList.remove('hidden');
        selectedAdminInitial.textContent = adminName.charAt(0).toUpperCase();
        selectedAdminName.textContent = adminName;
        welcomeMessage.classList.add('hidden');
        messagesArea.classList.remove('hidden');
        messageInput.classList.remove('hidden');
        loadMessages(adminId);
    }

    function loadMessages(adminId) {
        messagesContainer.innerHTML = '<div class="text-center text-gray-400 text-sm py-2">Memuat pesan...</div>';
        fetch(`/komunikasi/messages/${adminId}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    currentMessages = data.messages;
                    renderMessages(currentMessages);
                } else {
                    messagesContainer.innerHTML = '<div class="text-center text-gray-400">Gagal memuat pesan</div>';
                }
            })
            .catch(() => {
                messagesContainer.innerHTML = '<div class="text-center text-gray-400">Gagal memuat pesan</div>';
            });
    }

    function renderMessages(messages) {
        messagesContainer.innerHTML = '';

        if (!messages || messages.length === 0) {
            messagesContainer.innerHTML = '<div class="text-center text-gray-400 text-sm py-2">Belum ada pesan</div>';
            return;
        }

        messages.forEach(msg => {
            const isMe = msg.pengirim && msg.pengirim.id == window.currentUserId;
            const div = document.createElement('div');
            div.className = `flex ${isMe ? 'justify-end' : 'justify-start'} mb-2`;

            const messageTime = new Date(msg.createdAt).toLocaleTimeString('id-ID', {
                hour: '2-digit',
                minute: '2-digit'
            });

            div.innerHTML = `
                <div class="max-w-xs">
                    <div class="px-4 py-2 rounded-2xl ${isMe ? 'bg-primary text-white' : 'bg-gray-200 text-textPrimary'}">
                        ${msg.pesan}
                    </div>
                    <div class="text-xs text-gray-400 mt-1 ${isMe ? 'text-right' : 'text-left'}">
                        ${messageTime}
                    </div>
                </div>
            `;
            messagesContainer.appendChild(div);
        });

        // Scroll to bottom
        setTimeout(() => {
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }, 100);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const savedState = loadChatState();
        if (savedState) {
            // Find the admin in the list and select them
            const adminItem = document.querySelector(`[data-admin-id="${savedState.adminId}"]`);
            if (adminItem) {
                selectAdmin(savedState.adminId, savedState.adminName);
            } else {
                // Admin not found, clear state
                clearChatState();
            }
        }
    });

    adminItems.forEach(item => {
        item.addEventListener('click', function() {
            const adminId = this.getAttribute('data-admin-id');
            const adminName = this.getAttribute('data-admin-name');
            selectAdmin(adminId, adminName);
        });
    });

    if (messageForm) {
        messageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const text = messageText.value.trim();
            if (!text || !activeAdminId) return;

            messageText.disabled = true;
            const submitBtn = messageForm.querySelector('button[type="submit"]');
            submitBtn.disabled = true;

            // Send via fetch first
            fetch('/komunikasi/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    penerimaId: activeAdminId,
                    pesan: text
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    messageText.value = '';
                    
                    // Emit socket event for real-time update
                    socket.emit('send_message', {
                        pengirimId: window.currentUserId,
                        penerimaId: activeAdminId,
                        pesan: text,
                        senderRole: 'orangtua'
                    });
                    
                    console.log('Message sent via socket:', {
                        pengirimId: window.currentUserId,
                        penerimaId: activeAdminId,
                        pesan: text
                    });
                } else {
                    alert('Gagal mengirim pesan.');
                }
            })
            .catch(() => alert('Gagal mengirim pesan.'))
            .finally(() => {
                messageText.disabled = false;
                submitBtn.disabled = false;
                messageText.focus();
            });
        });
    }

    // Listen for new messages via socket
    socket.on('new_message', function(msg) {
        console.log('SOCKET NEW MESSAGE (orangtua):', msg, 'activeAdminId:', activeAdminId);
        if (activeAdminId && (msg.pengirimId == activeAdminId || msg.penerimaId == activeAdminId)) {
            // Add to current messages if not already there
            const existingMsg = currentMessages.find(m => m.id === msg.id && m.createdAt === msg.createdAt);
            if (!existingMsg) {
                currentMessages.push(msg);
                renderMessages(currentMessages);
            }
        }
    });

    document.addEventListener('beforeunload', function() {
        if (activeAdminId) {
            const adminItem = document.querySelector(`[data-admin-id="${activeAdminId}"]`);
            if (adminItem) {
                const adminName = adminItem.getAttribute('data-admin-name');
                saveChatState(activeAdminId, adminName);
            }
        }
    });

    function updateOnlineIndicators() {
        adminItems.forEach(item => {
            const adminId = item.dataset.adminId;
            console.log('Checking online status for admin:', adminId, 'Online users:', onlineUsers);
            if (onlineUsers.has(adminId)) {
                item.classList.add('online-indicator');
            } else {
                item.classList.remove('online-indicator');
            }
        });
    }

    // Listen online/offline events
    socket.on('user_online', ({ userId }) => {
        onlineUsers.add(String(userId));
        updateOnlineIndicators();
    });

    socket.on('user_offline', ({ userId }) => {
        onlineUsers.delete(String(userId));
        updateOnlineIndicators();
    });

    socket.on('online_users', (users) => {
        onlineUsers = new Set(users.map(String));
        updateOnlineIndicators();
    });

    // Request online users on load
    socket.emit('get_online_users');
</script>


    <script src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key="<%= process.env.MIDTRANS_CLIENT_KEY %>"></script>
    <script>
        function payNow(tagihanId, anakId, periode, amount, anakNama) {
            const paymentData = {};

            // If tagihanId is provided, use existing tagihan
            if (tagihanId) {
                paymentData.tagihanId = tagihanId;
                paymentData.amount = amount;
                paymentData.anakNama = anakNama;
            }
            // If anakId and periode are provided, create new tagihan
            else if (anakId && periode) {
                paymentData.anakId = anakId;
                paymentData.periode = periode;
                paymentData.amount = amount;
                paymentData.anakNama = anakNama;
            } else {
                alert('Data pembayaran tidak lengkap');
                return;
            }

            fetch('/payment/create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(paymentData)
                })
                .then(response => response.json())
                .then(data => {
                    console.log('Payment response received:', data);

                    if (data.success) {
                        if (data.snapToken) {
                            // New payment - use Snap
                            console.log('Using Snap payment with token:', data.snapToken);
                            snap.pay(data.snapToken, {
                                onSuccess: function(result) {
                                    console.log('Payment success:', result);
                                    window.location.href = '/payment/finish?order_id=' + result.order_id;
                                },
                                onPending: function(result) {
                                    console.log('Payment pending:', result);
                                    window.location.href = '/payment/unfinish?order_id=' + result.order_id;
                                },
                                onError: function(result) {
                                    console.log('Payment error:', result);
                                    window.location.href = '/payment/error?order_id=' + result.order_id;
                                },
                                onClose: function() {
                                    console.log('Payment popup closed');
                                }
                            });
                        } else if (data.redirectUrl || data.redirect_url) {
                            // Existing payment - redirect directly
                            const redirectUrl = data.redirectUrl || data.redirect_url;
                            console.log('Redirecting to existing payment:', redirectUrl);

                            // Show success message for reused payment
                            if (data.message) {
                                alert('Info: ' + data.message + '\n\nAnda akan diarahkan ke halaman pembayaran yang sudah ada.');
                            }

                            window.location.href = redirectUrl;
                        } else {
                            console.error('Invalid response - no snapToken or redirectUrl:', data);
                            alert('Response tidak valid dari server');
                        }
                    } else {
                        console.error('Payment creation failed:', data);
                        alert('Gagal membuat pembayaran: ' + (data.message || 'Error tidak diketahui'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Terjadi kesalahan saat membuat pembayaran');
                });
        }

        // Add event listeners for payment buttons
        document.addEventListener('DOMContentLoaded', function() {
            const paymentButtons = document.querySelectorAll('.pay-now-btn');
            paymentButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const tagihanId = this.getAttribute('data-tagihan-id');
                    const anakId = this.getAttribute('data-anak-id');
                    const periode = this.getAttribute('data-periode');
                    const amount = parseInt(this.getAttribute('data-amount'));
                    const anakNama = this.getAttribute('data-anak-nama');

                    payNow(tagihanId, anakId, periode, amount, anakNama);
                });
            });
        });
    </script>

    <script>
        // Filter and UI functionality
        document.addEventListener('DOMContentLoaded', function() {
            const statusFilter = document.getElementById('statusFilter');
            const sortOrder = document.getElementById('sortOrder');
            const resetFilters = document.getElementById('resetFilters');

            // Event listeners
            statusFilter.addEventListener('change', applyFilters);
            sortOrder.addEventListener('change', applyFilters);
            resetFilters.addEventListener('click', resetAllFilters);

            function applyFilters() {
                const statusValue = statusFilter.value;
                const sortValue = sortOrder.value;

                const periodCards = document.querySelectorAll('.period-card');

                let visibleCount = 0;

                periodCards.forEach(card => {
                    const cardStatus = card.getAttribute('data-status');
                    const shouldShow = statusValue === 'all' || statusValue === cardStatus;

                    if (shouldShow) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Apply sorting
                applySorting(sortValue);

                // Show/hide no results message
                const noResults = document.getElementById('noResults');
                if (visibleCount === 0) {
                    document.getElementById('tagihanContent').style.display = 'none';
                    noResults.style.display = 'block';
                } else {
                    document.getElementById('tagihanContent').style.display = 'block';
                    noResults.style.display = 'none';
                }

                updateSummaryStats();
            }

            function applySorting(sortValue) {
                const container = document.querySelector('#tagihanContent .grid');
                const periods = Array.from(document.querySelectorAll('.period-card'));

                periods.sort((a, b) => {
                    const aPeriode = a.getAttribute('data-periode');
                    const bPeriode = b.getAttribute('data-periode');
                    const aAmount = parseInt(a.getAttribute('data-amount'));
                    const bAmount = parseInt(b.getAttribute('data-amount'));

                    switch (sortValue) {
                        case 'oldest':
                            return aPeriode.localeCompare(bPeriode);
                        case 'newest':
                            return bPeriode.localeCompare(aPeriode);
                        case 'amount-high':
                            return bAmount - aAmount;
                        case 'amount-low':
                            return aAmount - bAmount;
                        default:
                            return bPeriode.localeCompare(aPeriode);
                    }
                });

                // Re-append sorted elements
                periods.forEach(period => {
                    container.appendChild(period);
                });
            }

            function resetAllFilters() {
                statusFilter.value = 'all';
                sortOrder.value = 'newest';
                applyFilters();
            }

            function updateSummaryStats() {
                const visibleCards = Array.from(document.querySelectorAll('.period-card')).filter(card =>
                    card.style.display !== 'none'
                );

                let totalPeriods = 0;
                let belumBayar = 0;
                let sudahLunas = 0;
                let totalAmount = 0;

                visibleCards.forEach(card => {
                    totalPeriods++;
                    const status = card.getAttribute('data-status');
                    const amount = parseInt(card.getAttribute('data-amount'));

                    if (status === 'belum_bayar' || status === 'belum_ada') {
                        belumBayar++;
                    }
                    if (status === 'lunas') {
                        sudahLunas++;
                    }

                    totalAmount += amount;
                });

                document.getElementById('totalPeriods').textContent = totalPeriods;
                document.getElementById('belumBayar').textContent = belumBayar;
                document.getElementById('sudahLunas').textContent = sudahLunas;
                document.getElementById('totalAmount').textContent = 'Rp ' + totalAmount.toLocaleString('id-ID');
            }

            // Payment button functionality
            const payButtons = document.querySelectorAll('.pay-now-btn');
            const paymentModal = document.getElementById('paymentModal');

            payButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const tagihanId = this.dataset.tagihanId;
                    const anakId = this.dataset.anakId;
                    const periode = this.dataset.periode;
                    const amount = this.dataset.amount;
                    const anakNama = this.dataset.anakNama;

                    // Show loading modal
                    paymentModal.classList.remove('hidden');

                    // Prepare payment data
                    const paymentData = {
                        amount: amount,
                        customer_details: {
                            first_name: anakNama
                        }
                    };

                    if (tagihanId) {
                        paymentData.tagihan_id = tagihanId;
                    } else if (anakId && periode) {
                        paymentData.anak_id = anakId;
                        paymentData.periode = periode;
                    }

                    // Send payment request
                    fetch('/payment/create', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(paymentData)
                        })
                        .then(response => response.json())
                        .then(data => {
                            paymentModal.classList.add('hidden');


                        })
                        .catch(error => {
                            paymentModal.classList.add('hidden');
                            console.error('Error:', error);
                            alert('Terjadi kesalahan saat memproses pembayaran');
                        });
                });
            });
        });
    </script>

</body>

</html>