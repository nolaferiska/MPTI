<div class="min-h-screen bg-primary flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex justify-center mb-6">
                <div class="bg-white/90 backdrop-blur-sm text-primary w-20 h-20 rounded-3xl flex items-center justify-center shadow-2xl border border-white/20">
                    <i class="fas fa-users text-3xl"></i>
                </div>
            </div>
            <h2 class="text-4xl font-bold text-textPrimary mb-4">
                Login Orang Tua
            </h2>
            <p class="text-lg text-textPrimary leading-relaxed">
                Masuk untuk mengakses dashboard dan memantau perkembangan anak Anda
            </p>
        </div>

        <!-- Flash Messages -->
        <% if (error_msg && error_msg.length > 0) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-2xl mb-6 backdrop-blur-sm">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span><%= error_msg[0] %></span>
                </div>
            </div>
            <% } %>

                <% if (success_msg && success_msg.length > 0) { %>
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-2xl mb-6 backdrop-blur-sm">
                        <div class="flex items-center">
                            <i class="fas fa-check-circle mr-2"></i>
                            <span><%= success_msg[0] %></span>
                        </div>
                    </div>
                    <% } %>

                        <% if (info_msg && info_msg.length > 0) { %>
                            <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-2xl mb-6 backdrop-blur-sm">
                                <div class="flex items-center">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    <span><%= info_msg[0] %></span>
                                </div>
                            </div>
                            <% } %>

                                <!-- Login Form -->
                                <div class="bg-white/90 backdrop-blur-sm rounded-3xl shadow-2xl p-8 border border-white/20">
                                    <form class="space-y-6" method="POST" action="/login">
                                        <div>
                                            <label for="email" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-envelope mr-2 text-primary"></i>
                        Email Address
                    </label>
                                            <input id="email" name="email" type="email" autocomplete="email" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg" placeholder="Masukkan email Anda">
                                        </div>

                                        <div>
                                            <label for="password" class="block text-sm font-semibold text-textPrimary mb-3">
                        <i class="fas fa-lock mr-2 text-primary"></i>
                        Password
                    </label>
                                            <div class="relative">
                                                <input id="password" name="password" type="password" autocomplete="current-password" required class="w-full px-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg pr-12"
                                                    placeholder="Masukkan password Anda">
                                                <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-4 flex items-center text-textSecondary hover:text-primary transition-colors">
                            <i id="password-icon" class="fas fa-eye text-lg"></i>
                        </button>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center">
                                                <input id="remember-me" name="remember-me" type="checkbox" class="h-5 w-5 text-primary focus:ring-primary border-gray-300 rounded transition-all duration-300">
                                                <label for="remember-me" class="ml-3 block text-sm text-textPrimary font-medium">
                            Ingat saya
                        </label>
                                            </div>

                                            <div class="text-sm">
                        <a href="/forgot-password" class="text-primary hover:text-secondary transition-colors font-semibold">
                            Lupa password?
                        </a>
                                            </div>
                                        </div>

                                        <div>
                                            <button type="submit" class="w-full bg-secondary backdrop-blur-sm text-textPrimary py-4 px-6 rounded-2xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 border border-white/20">
                        <i class="fas fa-sign-in-alt mr-3"></i>
                        Masuk ke Dashboard
                    </button>
                                        </div>

                                        <div class="text-center pt-4">
                                            <p class="text-textPrimary font-medium">
                                                Belum punya akun?
                                                <a href="/register" class="text-primary hover:text-secondary transition-colors font-bold">
                            Daftar di sini
                        </a>
                                            </p>
                                        </div>
                                    </form>
                                </div>

                                <!-- Resend Verification Email Form - Only show when there's unverified email error -->
                                <% if (error_msg && error_msg.length > 0 && error_msg[0].includes('belum diverifikasi')) { %>
                                    <div class="bg-white/80 backdrop-blur-sm rounded-3xl p-6 mt-6 border border-white/20">
                                        <div class="text-center mb-4">
                                            <h3 class="text-lg font-bold text-textPrimary mb-2">Belum menerima email verifikasi?</h3>
                                            <p class="text-textPrimary text-sm mb-4">
                                                Masukkan email Anda untuk mengirim ulang link verifikasi
                                            </p>
                                        </div>
                                        <form method="POST" action="/resend-verification" class="space-y-4">
                                            <div>
                                                <input type="email" name="email" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 text-lg" placeholder="Masukkan email Anda">
                                            </div>
                                            <div>
                                                <button type="submit" class="w-full bg-primary text-white py-3 px-6 rounded-2xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                            <i class="fas fa-paper-plane mr-2"></i>
                            Kirim Ulang Email Verifikasi
                        </button>
                                            </div>
                                        </form>
                                    </div>
                                    <% } %>

                                        <!-- Additional Info -->
                                        <div class="bg-white/80 backdrop-blur-sm rounded-3xl p-6 mt-8 border border-white/20">
                                            <div class="flex items-start space-x-4">
                                                <div class="bg-white text-primary w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0">
                                                    <i class="fas fa-info-circle text-xl"></i>
                                                </div>
                                                <div>
                                                    <h3 class="text-lg font-bold text-textPrimary mb-2">Informasi Login</h3>
                                                    <p class="text-textPrimary leading-relaxed">
                                                        Pastikan email Anda sudah diverifikasi sebelum login. Jika belum menerima email verifikasi, gunakan form di atas untuk mengirim ulang.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
    </div>
</div>
