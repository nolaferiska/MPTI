<!-- Edit Anak Form -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Edit Data Anak</h2>
            <p class="text-textSecondary">Edit data anak:
                <%= anak.nama %>
            </p>
        </div>
        <a href="/admin/anak" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Kembali
        </a>
    </div>

    <!-- Form -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <form method="POST" action="/admin/anak/edit/<%= anak.id %>" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nama -->
                <div>
                    <label for="nama" class="block text-sm font-medium text-textPrimary mb-2">
                        Nama Lengkap <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="nama" name="nama" value="<%= anak.nama %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Masukkan nama lengkap anak">
                </div>

                <!-- Tanggal Lahir -->
                <div>
                    <label for="tanggalLahir" class="block text-sm font-medium text-textPrimary mb-2">
                        Tanggal Lahir <span class="text-danger">*</span>
                    </label>
                    <input type="date" id="tanggalLahir" name="tanggalLahir" value="<%= new Date(anak.tanggalLahir).toISOString().split('T')[0] %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                </div>

                <!-- Jenis Kelamin -->
                <div>
                    <label for="jenisKelamin" class="block text-sm font-medium text-textPrimary mb-2">
                        Jenis Kelamin <span class="text-danger">*</span>
                    </label>
                    <select id="jenisKelamin" name="jenisKelamin" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="">Pilih jenis kelamin</option>
                        <option value="L" <%= anak.jenisKelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
                        <option value="P" <%= anak.jenisKelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
                    </select>
                </div>

                <!-- Orang Tua -->
                <div>
                    <label for="orangTuaId" class="block text-sm font-medium text-textPrimary mb-2">
                        Orang Tua <span class="text-danger">*</span>
                    </label>
                    <select id="orangTuaId" name="orangTuaId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="">Pilih orang tua</option>
                        <% if (orangTuaList && orangTuaList.length > 0) { %>
                            <% orangTuaList.forEach(orangTua => { %>
                                <option value="<%= orangTua.id %>" <%= anak.orangTuaId === orangTua.id ? 'selected' : '' %>>
                                    <%= orangTua.nama %> - <%= orangTua.telepon %>
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- Status -->
                <div>
                    <label for="status" class="block text-sm font-medium text-textPrimary mb-2">
                        Status <span class="text-danger">*</span>
                    </label>
                    <select id="status" name="status" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="aktif" <%= anak.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                        <option value="nonaktif" <%= anak.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
                    </select>
                </div>

                <!-- Alamat -->
                <div class="md:col-span-2">
                    <label for="alamat" class="block text-sm font-medium text-textPrimary mb-2">
                        Alamat <span class="text-danger">*</span>
                    </label>
                    <textarea id="alamat" name="alamat" required rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Masukkan alamat lengkap"><%= anak.alamat %></textarea>
                </div>

                <!-- Telepon Darurat -->
                <div>
                    <label for="teleponDarurat" class="block text-sm font-medium text-textPrimary mb-2">
                        Telepon Darurat
                    </label>
                    <input type="tel" id="teleponDarurat" name="teleponDarurat" value="<%= anak.teleponDarurat || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="08123456789">
                </div>

                <!-- Tanggal Masuk -->
                <div>
                    <label for="tanggalMasuk" class="block text-sm font-medium text-textPrimary mb-2">
                        Tanggal Masuk
                    </label>
                    <input type="date" id="tanggalMasuk" name="tanggalMasuk" value="<%= new Date(anak.tanggalMasuk).toISOString().split('T')[0] %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                </div>

                <!-- Kondisi Kesehatan -->
                <div>
                    <label for="kondisiKesehatan" class="block text-sm font-medium text-textPrimary mb-2">
                        Kondisi Kesehatan
                    </label>
                    <textarea id="kondisiKesehatan" name="kondisiKesehatan" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Kondisi kesehatan khusus (jika ada)"><%= anak.kondisiKesehatan || '' %></textarea>
                </div>

                <!-- Alergi -->
                <div>
                    <label for="alergi" class="block text-sm font-medium text-textPrimary mb-2">
                        Alergi
                    </label>
                    <textarea id="alergi" name="alergi" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Daftar alergi (jika ada)"><%= anak.alergi || '' %></textarea>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a href="/admin/anak" class="bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    Batal
                </a>
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-save mr-2"></i>
                    Update
                </button>
            </div>
        </form>
    </div>
</div>