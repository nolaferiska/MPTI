<!-- Komunikasi Management Page -->
<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-textPrimary">Komunikasi dengan Orang Tua</h2>
            <p class="text-textSecondary">Kelola komunikasi antara admin dan orang tua</p>
        </div>
    </div>

    <!-- Chat Interface -->
    <div class="bg-white rounded-lg shadow-sm">
        <div class="flex h-[600px]">
            <!-- User List Sidebar -->
            <div class="w-1/3 border-r border-gray-200">
                <div class="p-6 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-textPrimary">Daftar Orang Tua</h3>
                </div>
                <div class="overflow-y-auto h-full">
                    <% if (orangTuaList && orangTuaList.length > 0) { %>
                        <% orangTuaList.forEach(user => { %>
                            <div class="user-item p-4 border-b border-gray-100 cursor-pointer hover:bg-gray-50 transition-colors" data-user-id="<%= user.id %>" data-user-name="<%= user.nama %>">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center relative">
                                        <span class="text-white font-semibold text-sm"><%= user.nama.charAt(0).toUpperCase() %></span>
                                        <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-gray-400 rounded-full border-2 border-white online-indicator" data-user-id="<%= user.id %>"></div>
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="font-medium text-textPrimary">
                                            <%= user.nama %>
                                        </h4>
                                        <p class="text-sm text-textSecondary">
                                            <%= user.email %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="p-8 text-center text-textSecondary">
                                        <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <i class="fas fa-users text-2xl text-gray-400"></i>
                                        </div>
                                        <p>Tidak ada orang tua terdaftar</p>
                                    </div>
                                    <% } %>
                </div>
            </div>

            <!-- Chat Area -->
            <div class="flex-1 flex flex-col">
                <!-- Chat Header -->
                <div class="chat-header p-6 border-b border-gray-200 hidden" id="chatHeader">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center">
                            <span class="text-white font-semibold text-sm" id="selectedUserInitial"></span>
                        </div>
                        <div>
                            <h4 class="font-medium text-textPrimary" id="selectedUserName"></h4>
                            <p class="text-sm text-textSecondary">Sedang online</p>
                        </div>
                    </div>
                </div>

                <!-- Welcome Message -->
                <div class="welcome-message flex-1 flex items-center justify-center" id="welcomeMessage">
                    <div class="text-center">
                        <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-comments text-3xl text-gray-400"></i>
                        </div>
                        <h3 class="text-xl font-medium text-textPrimary mb-2">Selamat Datang di Komunikasi</h3>
                        <p class="text-textSecondary">Pilih orang tua dari daftar di sebelah kiri untuk memulai percakapan</p>
                    </div>
                </div>

                <!-- Messages Area -->
                <div class="messages-area flex-1 p-6 overflow-y-auto hidden bg-gray-50" id="messagesArea">
                    <div id="messagesContainer" class="space-y-4"></div>
                </div>

                <!-- Message Input -->
                <div class="message-input p-6 border-t border-gray-200 hidden" id="messageInput">
                    <form id="messageForm" class="flex space-x-3">
                        <input type="text" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" id="messageText" placeholder="Ketik pesan..." autocomplete="off">
                        <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
