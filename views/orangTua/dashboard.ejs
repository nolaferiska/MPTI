<div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="bg-white rounded-3xl shadow-lg p-8 mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-textPrimary mb-2">
                        Selamat Datang,
                        <%= user.nama %>!
                    </h1>
                    <p class="text-textSecondary">
                        Dashboard Orang Tua - Candice Kids Daycare
                    </p>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-textSecondary">
                        <i class="fas fa-user mr-1"></i>
                        <%= user.email %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-primary text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-child text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Anak Terdaftar</h3>
                        <p class="text-2xl font-bold text-primary">2</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-success text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-calendar-check text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Kehadiran Hari Ini</h3>
                        <p class="text-2xl font-bold text-success">2</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-warning text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-file-invoice-dollar text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Tagihan Pending</h3>
                        <p class="text-2xl font-bold text-warning">1</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-lg p-6">
                <div class="flex items-center">
                    <div class="bg-info text-white w-12 h-12 rounded-2xl flex items-center justify-center">
                        <i class="fas fa-comments text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-semibold text-textPrimary">Pesan Baru</h3>
                        <p class="text-2xl font-bold text-info">3</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Anak List -->
            <div class="bg-white rounded-3xl shadow-lg p-8">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-textPrimary">
                        <i class="fas fa-child mr-3 text-primary"></i> Data Anak
                    </h2>
                    <a href="/anak" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-plus mr-2"></i> Tambah Anak
                    </a>
                </div>

                <div class="space-y-4">
                    <div class="border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center">
                                    <i class="fas fa-child text-lg"></i>
                                </div>
                                <div class="ml-4">
                                    <h3 class="font-semibold text-textPrimary">Aisyah Putri Santoso</h3>
                                    <p class="text-sm text-textSecondary">Usia: 5 tahun</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="bg-success text-white px-3 py-1 rounded-full text-sm">
                                    Hadir
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-12 h-12 bg-secondary text-white rounded-full flex items-center justify-center">
                                    <i class="fas fa-child text-lg"></i>
                                </div>
                                <div class="ml-4">
                                    <h3 class="font-semibold text-textPrimary">Ahmad Rizki Indah</h3>
                                    <p class="text-sm text-textSecondary">Usia: 6 tahun</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="bg-success text-white px-3 py-1 rounded-full text-sm">
                                    Hadir
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activities -->
            <div class="bg-white rounded-3xl shadow-lg p-8">
                <h2 class="text-2xl font-bold text-textPrimary mb-6">
                    <i class="fas fa-clock mr-3 text-primary"></i> Aktivitas Terbaru
                </h2>

                <div class="space-y-4">
                    <div class="flex items-start space-x-4 p-4 bg-blue-50 rounded-2xl">
                        <div class="bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-puzzle-piece text-sm"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-semibold text-textPrimary">Bermain Puzzle</h4>
                            <p class="text-sm text-textSecondary">Aisyah bermain puzzle dan menyelesaikan gambar dengan baik</p>
                            <p class="text-xs text-textSecondary mt-1">2 jam yang lalu</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4 p-4 bg-green-50 rounded-2xl">
                        <div class="bg-success text-white w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-utensils text-sm"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-semibold text-textPrimary">Makan Siang</h4>
                            <p class="text-sm text-textSecondary">Ahmad makan siang dengan lahap, menu: nasi goreng dan sayur</p>
                            <p class="text-xs text-textSecondary mt-1">4 jam yang lalu</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4 p-4 bg-yellow-50 rounded-2xl">
                        <div class="bg-warning text-white w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-book text-sm"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-semibold text-textPrimary">Belajar Huruf</h4>
                            <p class="text-sm text-textSecondary">Aisyah belajar mengenal huruf A-Z dengan baik</p>
                            <p class="text-xs text-textSecondary mt-1">6 jam yang lalu</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-3xl shadow-lg p-8 mt-8">
            <h2 class="text-2xl font-bold text-textPrimary mb-6">
                <i class="fas fa-bolt mr-3 text-primary"></i> Akses Cepat
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <a href="/absen" class="bg-primary text-white p-6 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                    <div class="text-center">
                        <i class="fas fa-calendar-check text-3xl mb-4"></i>
                        <h3 class="font-semibold text-lg">Absen Anak</h3>
                        <p class="text-sm opacity-90">Lihat kehadiran anak</p>
                    </div>
                </a>

                <a href="/aktivitas" class="bg-success text-white p-6 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                    <div class="text-center">
                        <i class="fas fa-play-circle text-3xl mb-4"></i>
                        <h3 class="font-semibold text-lg">Aktivitas Harian</h3>
                        <p class="text-sm opacity-90">Lihat aktivitas anak</p>
                    </div>
                </a>

                <a href="/chat" class="bg-info text-white p-6 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                    <div class="text-center">
                        <i class="fas fa-comments text-3xl mb-4"></i>
                        <h3 class="font-semibold text-lg">Chat Admin</h3>
                        <p class="text-sm opacity-90">Komunikasi dengan admin</p>
                    </div>
                </a>

                <a href="/tagihan" class="bg-warning text-white p-6 rounded-2xl hover:shadow-lg transition-all duration-300 hover:scale-105">
                    <div class="text-center">
                        <i class="fas fa-file-invoice-dollar text-3xl mb-4"></i>
                        <h3 class="font-semibold text-lg">Tagihan</h3>
                        <p class="text-sm opacity-90">Lihat tagihan & pembayaran</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>