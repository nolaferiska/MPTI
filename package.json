{
    "name": "candice-kids",
    "version": "1.0.0",
    "description": "Candice Kids - Daycare Management System",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "build": "npx tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
        "watch-css": "npx tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
        "dev-full": "npm run watch-css & npm run dev",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "db:seed": "node prisma/seed.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "daycare",
        "kids",
        "management",
        "express"
    ],
    "author": "",
    "license": "ISC",
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcrypt": "^5.1.1",
        "connect-flash": "^0.1.1",
        "dotenv": "^16.4.7",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "express-ejs-layouts": "^2.5.1",
        "express-session": "^1.18.1",
        "midtrans-client": "^1.4.3",
        "moment": "^2.30.1",
        "multer": "^1.4.4",
        "mysql2": "^3.11.5",
        "sequelize": "^6.37.7",
        "sequelize-cli": "^6.6.3",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "concurrently": "^9.2.0",
        "eslint": "^9.30.1",
        "nodemon": "^3.1.9",
        "prettier": "^3.6.2",
        "prisma": "^5.22.0",
        "rimraf": "^6.0.1",
        "tailwindcss": "^3.4.17"
    }
}
