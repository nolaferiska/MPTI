<!-- Notifikasi Darurat Detail Page -->
<div class="space-y-6" data-user-id="<%= currentUserId %>">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a href="/notifikasi" class="text-primary hover:text-primary-dark">
                <i class="fas fa-arrow-left text-xl"></i>
            </a>
            <div>
                <h2 class="text-2xl font-bold text-textPrimary">Detail Notifikasi Darurat</h2>
                <p class="text-textSecondary">Informasi lengkap notifikasi darurat</p>
            </div>
        </div>
        
        <!-- Status Badge -->
        <% 
            const isUrgent = (() => {
                const now = new Date();
                const created = new Date(notifikasi.createdAt);
                const diffHours = (now - created) / (1000 * 60 * 60);
                return diffHours <= 24;
            })();
        %>
        <% if (isUrgent) { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-red-100 text-red-800">
                <i class="fas fa-exclamation-circle mr-2"></i>URGENT - 24 Jam
            </span>
        <% } else { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                <i class="fas fa-info-circle mr-2"></i>Normal
            </span>
        <% } %>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Notifikasi Detail -->
        <div class="lg:col-span-2">
            <div class="bg-secondary rounded-lg shadow-sm p-6">
                <div class="border-b border-gray-200 pb-4 mb-6">
                    <div class="flex items-start space-x-4">
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-textPrimary mb-2">Notifikasi Darurat</h3>
                            <div class="text-sm text-textSecondary space-y-1">
                                <p><i class="fas fa-calendar mr-2"></i><%= new Date(notifikasi.createdAt).toLocaleDateString('id-ID', {
                                    weekday: 'long',
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric'
                                }) %></p>
                                <p><i class="fas fa-clock mr-2"></i><%= new Date(notifikasi.createdAt).toLocaleTimeString('id-ID', {
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %> WIB</p>
                                <p><i class="fas fa-user mr-2"></i>Dibuat oleh: <%= notifikasi.createdByUser?.nama || 'Admin' %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Deskripsi Notifikasi -->
                <div class="mb-6">
                    <h4 class="text-md font-medium text-textPrimary mb-3">Deskripsi Kejadian</h4>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <p class="text-textPrimary leading-relaxed whitespace-pre-wrap"><%= notifikasi.deskripsi %></p>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="mb-6">
                    <h4 class="text-md font-medium text-textPrimary mb-3">Timeline</h4>
                    <div class="border-l-2 border-gray-200 pl-4 ml-2">
                        <div class="relative">
                            <div class="absolute -left-6 w-3 h-3 bg-red-500 rounded-full"></div>
                            <div class="pb-4">
                                <p class="text-sm font-medium text-textPrimary">Notifikasi dibuat</p>
                                <p class="text-sm text-textSecondary">
                                    <%= new Date(notifikasi.createdAt).toLocaleDateString('id-ID', {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </p>
                                <p class="text-sm text-textSecondary mt-1">Oleh: <%= notifikasi.createdByUser?.nama || 'Admin' %></p>
                            </div>
                        </div>
                        <% if (notifikasi.updatedAt && notifikasi.updatedAt !== notifikasi.createdAt) { %>
                            <div class="relative">
                                <div class="absolute -left-6 w-3 h-3 bg-blue-500 rounded-full"></div>
                                <div class="pb-4">
                                    <p class="text-sm font-medium text-textPrimary">Notifikasi diperbarui</p>
                                    <p class="text-sm text-textSecondary">
                                        <%= new Date(notifikasi.updatedAt).toLocaleDateString('id-ID', {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit'
                                        }) %>
                                    </p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Actions -->
                <div class="border-t border-gray-200 pt-6">
                    <div class="flex space-x-3">
                        <a href="/notifikasi" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                            <i class="fas fa-arrow-left mr-2"></i>Kembali ke Daftar
                        </a>
                        <a href="/komunikasi" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                            <i class="fas fa-comments mr-2"></i>Chat dengan Admin
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Informasi Anak -->
            <div class="bg-secondary rounded-lg shadow-sm p-6">
                <h4 class="text-lg font-medium text-textPrimary mb-4">Informasi Anak</h4>
                <div class="flex items-center space-x-4 mb-4">
                    <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center">
                        <span class="text-white text-xl font-semibold">
                            <%= notifikasi.anak.nama.charAt(0).toUpperCase() %>
                        </span>
                    </div>
                    <div>
                        <h5 class="font-semibold text-textPrimary"><%= notifikasi.anak.nama %></h5>
                        <p class="text-sm text-textSecondary"><%= notifikasi.anak.umur %> tahun</p>
                    </div>
                </div>
                
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-textSecondary">Tanggal Lahir:</span>
                        <span class="text-textPrimary"><%= new Date(notifikasi.anak.tanggalLahir).toLocaleDateString('id-ID') %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-textSecondary">Jenis Kelamin:</span>
                        <span class="text-textPrimary"><%= notifikasi.anak.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-textSecondary">Status:</span>
                        <span class="px-2 py-1 text-xs rounded-full <%= notifikasi.anak.status === 'aktif' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                            <%= notifikasi.anak.status %>
                        </span>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-t border-gray-200">
                    <a href="/kelola-anak/detail/<%= notifikasi.anak.id %>" class="text-textPrimary hover:text-primary-dark text-sm">
                        <i class="fas fa-eye mr-1"></i>Lihat Detail Anak
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
