<div class="container mx-auto px-4 py-6">
    <div class="bg-secondary rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">
                    <i class="fas fa-file-invoice-dollar text-blue-600 mr-3"></i>
                    Tagihan & Pembayaran
                </h1>
                <p class="text-gray-600 mt-1">Pilih anak untuk melihat tagihan bulanan</p>
            </div>
        </div>

        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error_msg %>
            </div>
        <% } %>

        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <%= success_msg %>
            </div>
        <% } %>

        <% if (tagihanPeriods && tagihanPeriods.length > 0) { %>
            <!-- Summary Stats -->
            <div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-gradient-to-r from-blue-50 to-blue-100 rounded-lg p-4 text-center">
                    <div class="text-3xl font-bold text-blue-600"><%= tagihanPeriods.length %></div>
                    <div class="text-sm text-blue-700">Total Anak</div>
                </div>
                <div class="bg-gradient-to-r from-red-50 to-red-100 rounded-lg p-4 text-center">
                    <div class="text-3xl font-bold text-red-600" id="totalBelumBayar">
                        <%= tagihanPeriods.reduce((sum, anak) => sum + anak.periods.filter(p => p.status === 'belum_bayar' || p.status === 'belum_ada').length, 0) %>
                    </div>
                    <div class="text-sm text-red-700">Belum Bayar</div>
                </div>
                <div class="bg-gradient-to-r from-green-50 to-green-100 rounded-lg p-4 text-center">
                    <div class="text-3xl font-bold text-green-600" id="totalLunas">
                        <%= tagihanPeriods.reduce((sum, anak) => sum + anak.periods.filter(p => p.status === 'lunas').length, 0) %>
                    </div>
                    <div class="text-sm text-green-700">Sudah Lunas</div>
                </div>
                <div class="bg-gradient-to-r from-purple-50 to-purple-100 rounded-lg p-4 text-center">
                    <div class="text-3xl font-bold text-purple-600" id="totalPeriods">
                        <%= tagihanPeriods.reduce((sum, anak) => sum + anak.periods.length, 0) %>
                    </div>
                    <div class="text-sm text-purple-700">Total Periode</div>
                </div>
            </div>

            <!-- Anak List -->
            <div class="grid gap-6">
                <% tagihanPeriods.forEach(anakData => { %>
                    <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow duration-200">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <!-- Avatar -->
                                <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-bold text-xl mr-4 shadow-lg">
                                    <%= anakData.anak.nama.charAt(0).toUpperCase() %>
                                </div>
                                
                                <div>
                                    <h3 class="text-xl font-semibold text-gray-800 mb-1">
                                        <%= anakData.anak.nama %>
                                    </h3>
                                    <p class="text-gray-600 text-sm mb-2">
                                        <i class="fas fa-calendar text-gray-400 mr-1"></i>
                                        Terdaftar sejak: <%= anakData.anak.tanggalMasuk ? new Date(anakData.anak.tanggalMasuk).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Tidak diketahui' %>
                                    </p>
                                    
                                    <!-- Quick Stats -->
                                    <div class="flex items-center gap-4 text-sm">
                                        <div class="flex items-center">
                                            <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                                            <span class="text-gray-600"><%= anakData.periods.length %> periode</span>
                                        </div>
                                        <div class="flex items-center">
                                            <span class="w-3 h-3 bg-red-500 rounded-full mr-2"></span>
                                            <span class="text-gray-600"><%= anakData.periods.filter(p => p.status === 'belum_bayar' || p.status === 'belum_ada').length %> belum bayar</span>
                                        </div>
                                        <div class="flex items-center">
                                            <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                                            <span class="text-gray-600"><%= anakData.periods.filter(p => p.status === 'lunas').length %> lunas</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-right">
                                <!-- Status Indicators -->
                                <div class="mb-3">
                                    <% 
                                    const belumBayarCount = anakData.periods.filter(p => p.status === 'belum_bayar' || p.status === 'belum_ada').length;
                                    const lunasCount = anakData.periods.filter(p => p.status === 'lunas').length;
                                    %>
                                    <% if (belumBayarCount > 0) { %>
                                        <span class="inline-block px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium mr-2">
                                            <i class="fas fa-exclamation-circle mr-1"></i>
                                            <%= belumBayarCount %> Perlu Bayar
                                        </span>
                                    <% } %>
                                    <% if (lunasCount > 0) { %>
                                        <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">
                                            <i class="fas fa-check-circle mr-1"></i>
                                            <%= lunasCount %> Lunas
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Total Amount -->
                                <div class="mb-3">
                                    <p class="text-2xl font-bold text-gray-800">
                                        Rp <%= anakData.periods.reduce((sum, p) => sum + parseInt(p.jumlah), 0).toLocaleString('id-ID') %>
                                    </p>
                                    <p class="text-sm text-gray-600">Total tagihan</p>
                                </div>

                                <!-- Action Button -->
                                <a href="/tagihan/anak/<%= anakData.anak.id %>" 
                                   class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition duration-200 shadow-md hover:shadow-lg">
                                    <i class="fas fa-eye mr-2"></i>
                                    Lihat Tagihan
                                    <i class="fas fa-arrow-right ml-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

        <% } else { %>
            <div class="text-center py-12">
                <div class="text-gray-400 mb-4">
                    <i class="fas fa-child text-6xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-700 mb-2">Tidak Ada Data Anak</h3>
                <p class="text-gray-500 mb-6">Silakan daftarkan anak Anda terlebih dahulu untuk melihat tagihan</p>
                <a href="/kelola-anak/add" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition duration-200">
                    <i class="fas fa-plus mr-2"></i>
                    Daftarkan Anak
                </a>
            </div>
        <% } %>
    </div>
</div>
